---
layout: default
---
{% unless site.data.resume %}
  <div class="cv-wrapper">
    <section class="cv-hero">
      <div class="cv-hero-inner">
        <div class="cv-hero-main">
          <h1 class="cv-title">{{ page.title }} <span class="cv-tag">AI Engineer</span></h1>
          <p class="cv-sub">Vision-Language Models • Applied Machine Learning • Systems Architecture</p>
          <div class="cv-actions">
            {% if page.cv_pdf %}
              <a class="cv-btn primary" {% if page.cv_pdf contains '://' %}href="{{ page.cv_pdf }}"{% else %}href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"{% endif %} target="_blank" rel="noopener"><i class="fa-solid fa-file-pdf"></i> Download PDF</a>
            {% endif %}
            <a class="cv-btn ghost" href="/work/"><i class="fa-solid fa-briefcase"></i> Work</a>
            <a class="cv-btn ghost" href="/achievements/"><i class="fa-solid fa-trophy"></i> Achievements</a>
            <a class="cv-btn ghost" href="mailto:sanjanacharaya1234@gmail.com?subject=Collaboration"><i class="fa-solid fa-envelope"></i> Contact</a>
          </div>
          <ul class="cv-metrics">
            <li><strong>Top 1%</strong><span>Academic Standing</span></li>
            <li><strong>National Champion</strong><span>HackFusion 2025</span></li>
            <li><strong>25+ Projects</strong><span>Delivered</span></li>
            <li><strong>500+ Students</strong><span>Mentored/Impacted</span></li>
          </ul>
        </div>
      </div>
    </section>
    <div class="cv-body container-lg">
      <aside class="cv-index" id="cv-index" aria-label="CV section index"></aside>
      <main class="cv-main">
        <div class="cv">
          {% for entry in site.data.cv %}
            <a class="anchor" id="{{ entry.title | slugify }}"></a>
            <section class="cv-section" data-title="{{ entry.title }}">
              <h2 class="cv-section-title">{{ entry.title }}</h2>
              <div class="cv-section-content">
                {% if entry.type == 'list' %}
                  {% include cv/list.liquid %}
                {% elsif entry.type == 'map' %}
                  {% include cv/map.liquid %}
                {% elsif entry.type == 'nested_list' %}
                  {% include cv/nested_list.liquid %}
                {% elsif entry.type == 'time_table' %}
                  <div class="timeline">
                    {% include cv/time_table.liquid %}
                  </div>
                {% elsif entry.type == 'list_groups' %}
                  {% include cv/list_groups.liquid %}
                {% elsif entry.type == 'skills_matrix' %}
                  {% include cv/skills_matrix.liquid entry=entry %}
                {% else %}
                  {{ entry.contents }}
                {% endif %}
              </div>
            </section>
          {% endfor %}
        </div>
      </main>
    </div>
  </div>
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for data in site.data.resume %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ data[0] | capitalize }}</h3>
            <div>
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}

<style>
/* CV Hero */
.cv-wrapper{--cv-accent:var(--global-theme-color);margin:0 0 2rem}
.cv-hero{background:linear-gradient(110deg,var(--cv-accent)0%,#242038 55%,#101010 100%);color:#fff;padding:3rem 0 2.2rem;position:relative;overflow:hidden}
.cv-hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 18% 22%,rgba(255,255,255,.15),transparent 65%)}
.cv-hero-inner{max-width:1150px;margin:0 auto;padding:0 1.2rem}
.cv-title{margin:0 0 .6rem;font-size:clamp(2.3rem,5vw,3.15rem);line-height:1.05;font-weight:650;letter-spacing:-.5px}
.cv-tag{display:inline-block;font-size:.8rem;letter-spacing:.08em;vertical-align:middle;margin-left:.75rem;padding:.35rem .6rem;background:rgba(255,255,255,.17);border-radius:8px;backdrop-filter:blur(4px)}
.cv-sub{margin:.2rem 0 1.4rem;font-size:1.02rem;max-width:820px;line-height:1.5}
.cv-actions{display:flex;flex-wrap:wrap;gap:.6rem;margin:0 0 1.4rem}
.cv-btn{border:1px solid rgba(255,255,255,.3);padding:.6rem .95rem;border-radius:10px;font-size:.78rem;letter-spacing:.06em;text-decoration:none;color:#fff;background:rgba(255,255,255,.12);display:inline-flex;align-items:center;gap:.4rem;font-weight:500;backdrop-filter:blur(4px);transition:background .25s,border-color .25s}
.cv-btn.primary{background:#fff;color:#000;font-weight:600}
.cv-btn:hover{background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.55)}
.cv-btn.primary:hover{background:var(--global-code-bg-color);color:var(--global-text-color)}
.cv-metrics{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.75rem;max-width:980px}
.cv-metrics li{background:rgba(255,255,255,.12);padding:.75rem .8rem;border-radius:12px;display:flex;flex-direction:column;gap:.15rem;font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;font-weight:500}
.cv-metrics li strong{font-size:.95rem;letter-spacing:0;font-weight:600}

/* Layout body */
.cv-body{display:grid;grid-template-columns:250px minmax(0,1fr);gap:2.2rem;align-items:start}
.cv-index{position:sticky;top:5.5rem;display:flex;flex-direction:column;gap:.4rem;font-size:.7rem;max-height:calc(100vh - 6rem);overflow:auto;padding-right:.4rem}
.cv-index a{text-decoration:none;padding:.35rem .55rem;border-radius:6px;color:var(--global-text-color-light);line-height:1.1;display:block;transition:background .2s,color .2s}
.cv-index a:hover,.cv-index a.active{background:var(--global-code-bg-color);color:var(--global-text-color)}

.cv-main{min-width:0}
.cv-section{margin:0 0 2.4rem}
.cv-section-title{margin:0 0 1rem;font-size:1.4rem;font-weight:600;letter-spacing:-.5px}
.cv-section-content{display:flex;flex-direction:column;gap:.6rem}

/* Timeline styling (wrap existing time_table output) */
.timeline table{width:100%}
.timeline .table-responsive{overflow:visible}
.timeline-entry{position:relative;padding:0 0 1.6rem 1.8rem}
.timeline-entry:before{content:"";position:absolute;left:.55rem;top:.3rem;bottom:-.2rem;width:2px;background:var(--global-divider-color)}
.timeline-entry:last-child:before{bottom:1.1rem}
.timeline-entry .t-dot{position:absolute;left:0;top:.35rem;width:14px;height:14px;border-radius:50%;background:var(--cv-accent);box-shadow:0 0 0 3px var(--global-bg-color)}

/* Skill matrix */
.skill-matrix{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;margin-top:.5rem}
.skill-group{background:var(--global-card-bg-color);border:1px solid var(--global-divider-color);padding:.85rem .8rem;border-radius:12px;display:flex;flex-direction:column;gap:.55rem}
.skill-group h4{margin:0;font-size:.85rem;letter-spacing:.07em;text-transform:uppercase;color:var(--global-text-color-light)}
.skill-item{display:flex;align-items:center;justify-content:space-between;font-size:.78rem;gap:.75rem}
.skill-bar{flex:1;height:6px;background:var(--global-code-bg-color);border-radius:4px;overflow:hidden;position:relative}
.skill-bar span{position:absolute;inset:0;background:linear-gradient(90deg,var(--cv-accent),var(--global-theme-color-light));transform:scaleX(var(--p));transform-origin:left;transition:transform 1s cubic-bezier(.4,.1,.2,1)}
.skill-item[data-level="expert"] .skill-bar span{--p:.95}
.skill-item[data-level="advanced"] .skill-bar span{--p:.8}
.skill-item[data-level="intermediate"] .skill-bar span{--p:.6}
.skill-item[data-level="foundational"] .skill-bar span{--p:.4}
.skill-level{font-size:.6rem;letter-spacing:.07em;text-transform:uppercase;color:var(--global-text-color-light);min-width:70px;text-align:right}

/* Responsive */
@media (max-width:1080px){.cv-body{grid-template-columns:200px 1fr;gap:1.6rem}}
@media (max-width:900px){.cv-body{grid-template-columns:1fr}.cv-index{position:relative;top:0;flex-direction:row;overflow-x:auto;max-height:none;white-space:nowrap;padding-bottom:.4rem}.cv-index a{flex:0 0 auto}}
@media (max-width:650px){.cv-hero{padding:2.4rem 0 1.6rem}.cv-title{font-size:2.2rem}.cv-sub{font-size:.95rem}.cv-actions{gap:.45rem}.cv-btn{font-size:.7rem;padding:.55rem .75rem}.cv-metrics{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.55rem}.cv-section-title{font-size:1.25rem}}
</style>

<script>
(function(){
  // Build index
  const index=document.getElementById('cv-index');
  if(index){
    const sections=[...document.querySelectorAll('.cv-section')];
    const frag=document.createDocumentFragment();
    sections.forEach(sec=>{const id=sec.querySelector('.anchor')?sec.querySelector('.anchor').id:sec.id || sec.getAttribute('data-title').toLowerCase().replace(/[^a-z0-9]+/g,'-'); if(!sec.id) sec.id=id; const a=document.createElement('a'); a.href='#'+id; a.textContent=sec.getAttribute('data-title'); frag.appendChild(a);});
    index.appendChild(frag);
    // Active highlight
    const links=[...index.querySelectorAll('a')];
    const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){links.forEach(l=>l.classList.toggle('active',l.getAttribute('href')==='#'+e.target.id));}})},{rootMargin:'-45% 0px -50% 0px'});
    sections.forEach(s=>io.observe(s));
  }
})();
</script>
