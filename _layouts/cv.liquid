---
layout: default
---
{% unless site.data.resume %}
  <div class="professional-journey-wrapper">
    <!-- Hero Section -->
    <section class="journey-hero">
      <div class="hero-background">
        <div class="hero-gradient"></div>
        <div class="hero-pattern"></div>
      </div>
      <div class="journey-hero-inner">
        <div class="hero-content">
          <div class="hero-badge">🚀 Professional Journey</div>
          <h1 class="hero-title">{{ page.title }}</h1>
          <p class="hero-subtitle">{{ page.description }}</p>
          <div class="hero-actions">
            {% if page.cv_pdf %}
              <a class="hero-btn primary" {% if page.cv_pdf contains '://' %}href="{{ page.cv_pdf }}"{% else %}href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"{% endif %} target="_blank" rel="noopener">
                <i class="fa-solid fa-file-pdf"></i> Download Resume
              </a>
            {% endif %}
            <a class="hero-btn secondary" href="mailto:sanjanacharaya1234@gmail.com?subject=Let's%20Collaborate">
              <i class="fa-solid fa-envelope"></i> Get in Touch
            </a>
            <a class="hero-btn ghost" href="/work/">
              <i class="fa-solid fa-briefcase"></i> View Work
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Journey Content -->
    <div class="journey-body">
      <aside class="journey-navigation" id="journey-nav">
        <div class="nav-header">
          <h3>Journey Map</h3>
          <div class="nav-progress">
            <div class="progress-bar"></div>
          </div>
        </div>
        <nav class="nav-links" aria-label="Professional journey navigation"></nav>
      </aside>

      <main class="journey-content">
        {% for entry in site.data.cv %}
          <a class="anchor" id="{{ entry.title | slugify }}"></a>
          <section class="journey-section" data-title="{{ entry.title }}">
            
            {% if entry.type == 'hero_profile' %}
              <div class="profile-hero">
                <div class="profile-header">
                  <div class="profile-avatar">
                    <div class="avatar-placeholder">{{ entry.contents[0].value | slice: 0, 2 | upcase }}</div>
                  </div>
                  <div class="profile-info">
                    <h2 class="profile-name">{{ entry.contents[0].value }}</h2>
                    <p class="profile-title">{{ entry.contents[1].value }}</p>
                    <p class="profile-mission">{{ entry.contents[3].value }}</p>
                  </div>
                </div>
                <div class="profile-metrics">
                  <div class="metric-item">
                    <span class="metric-value">Top 1%</span>
                    <span class="metric-label">Academic Standing</span>
                  </div>
                  <div class="metric-item">
                    <span class="metric-value">500+</span>
                    <span class="metric-label">Students Mentored</span>
                  </div>
                  <div class="metric-item">
                    <span class="metric-value">25+</span>
                    <span class="metric-label">Projects Delivered</span>
                  </div>
                  <div class="metric-item">
                    <span class="metric-value">🏆</span>
                    <span class="metric-label">National Champion</span>
                  </div>
                </div>
              </div>

            {% elsif entry.type == 'journey_section' %}
              <div class="journey-phase">
                <h2 class="section-title">{{ entry.title }}</h2>
                <p class="section-subtitle">{{ entry.subtitle }}</p>
                {% for item in entry.contents %}
                  <div class="phase-card">
                    <div class="phase-header">
                      <h3>{{ item.phase }}</h3>
                      <span class="phase-period">{{ item.period }}</span>
                    </div>
                    <p class="phase-description">{{ item.description }}</p>
                    <div class="phase-achievements">
                      {% for achievement in item.achievements %}
                        <div class="achievement-item">{{ achievement }}</div>
                      {% endfor %}
                    </div>
                    <div class="phase-technologies">
                      {% for tech in item.technologies %}
                        <span class="tech-badge">{{ tech }}</span>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>

            {% elsif entry.type == 'education_journey' %}
              <div class="education-story">
                <h2 class="section-title">{{ entry.title }}</h2>
                {% for edu in entry.contents %}
                  <div class="education-card">
                    <div class="edu-header">
                      <div class="edu-icon">🎓</div>
                      <div class="edu-details">
                        <h3>{{ edu.title }}</h3>
                        <p class="edu-subtitle">{{ edu.subtitle }}</p>
                        <p class="edu-institution">{{ edu.institution }}</p>
                        <div class="edu-metrics">
                          <span class="gpa">GPA: {{ edu.gpa }}</span>
                          <span class="rank">{{ edu.rank }}</span>
                          <span class="period">{{ edu.period }}</span>
                        </div>
                      </div>
                    </div>
                    <p class="edu-story">{{ edu.story }}</p>
                    <div class="edu-highlights">
                      <div class="highlight-grid">
                        <div class="highlight-item">
                          <h4>Key Courses</h4>
                          <ul>
                            {% for course in edu.key_courses %}
                              <li>{{ course }}</li>
                            {% endfor %}
                          </ul>
                        </div>
                        <div class="highlight-item">
                          <h4>Achievements</h4>
                          <ul>
                            {% for achievement in edu.achievements %}
                              <li>{{ achievement }}</li>
                            {% endfor %}
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>

            {% elsif entry.type == 'career_timeline' %}
              <div class="career-journey">
                <h2 class="section-title">{{ entry.title }}</h2>
                <p class="section-subtitle">{{ entry.subtitle }}</p>
                <div class="timeline-container">
                  {% for role in entry.contents %}
                    <div class="timeline-item">
                      <div class="timeline-marker">
                        <div class="marker-dot"></div>
                        <div class="marker-line"></div>
                      </div>
                      <div class="timeline-content">
                        <div class="role-header">
                          <h3>{{ role.title }}</h3>
                          <span class="company">{{ role.company }}</span>
                          <span class="period">{{ role.period }}</span>
                          <span class="role-type">{{ role.type }}</span>
                        </div>
                        <p class="role-story">{{ role.story }}</p>
                        <div class="impact-metrics">
                          <h4>Key Impact</h4>
                          <ul>
                            {% for impact in role.impact %}
                              <li>{{ impact }}</li>
                            {% endfor %}
                          </ul>
                        </div>
                        <div class="role-technologies">
                          {% for tech in role.technologies %}
                            <span class="tech-tag">{{ tech }}</span>
                          {% endfor %}
                        </div>
                        <div class="key-learning">
                          <strong>Key Learning:</strong> {{ role.key_learning }}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

            {% elsif entry.type == 'project_showcase' %}
              <div class="project-showcase">
                <h2 class="section-title">{{ entry.title }}</h2>
                <p class="section-subtitle">{{ entry.subtitle }}</p>
                <div class="project-grid">
                  {% for project in entry.contents %}
                    <div class="project-card">
                      <div class="project-header">
                        <h3>{{ project.title }}</h3>
                        <span class="project-status">{{ project.status }}</span>
                        {% if project.competition %}
                          <span class="project-competition">{{ project.competition }}</span>
                        {% endif %}
                        <span class="project-period">{{ project.period }}</span>
                      </div>
                      <p class="project-story">{{ project.story }}</p>
                      
                      {% if project.technical_architecture %}
                        <div class="project-section">
                          <h4>Technical Architecture</h4>
                          <ul>
                            {% for item in project.technical_architecture %}
                              <li>{{ item }}</li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}

                      {% if project.impact_metrics %}
                        <div class="project-section">
                          <h4>Impact Metrics</h4>
                          <ul>
                            {% for metric in project.impact_metrics %}
                              <li>{{ metric }}</li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}

                      {% if project.business_impact %}
                        <div class="project-section">
                          <h4>Business Impact</h4>
                          <ul>
                            {% for impact in project.business_impact %}
                              <li>{{ impact }}</li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}

                      <div class="project-technologies">
                        {% for tech in project.technologies %}
                          <span class="tech-badge">{{ tech }}</span>
                        {% endfor %}
                      </div>

                      {% if project.recognition %}
                        <div class="project-recognition">🏆 {{ project.recognition }}</div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>

            {% elsif entry.type == 'achievement_timeline' %}
              <div class="achievement-timeline">
                <h2 class="section-title">{{ entry.title }}</h2>
                <p class="section-subtitle">{{ entry.subtitle }}</p>
                <div class="achievement-container">
                  {% for year_group in entry.contents %}
                    <div class="achievement-year">
                      <h3 class="year-label">{{ year_group.year }}</h3>
                      <div class="year-achievements">
                        {% for achievement in year_group.achievements %}
                          <div class="achievement-card">
                            <h4>{{ achievement.title }}</h4>
                            <p class="achievement-description">{{ achievement.description }}</p>
                            <p class="achievement-impact">{{ achievement.impact }}</p>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

            {% elsif entry.type == 'skills_journey' %}
              <div class="skills-journey">
                <h2 class="section-title">{{ entry.title }}</h2>
                <p class="section-subtitle">{{ entry.subtitle }}</p>
                <div class="skills-domains">
                  {% for domain in entry.contents %}
                    <div class="skill-domain">
                      <div class="domain-header">
                        <h3>{{ domain.domain }}</h3>
                        <span class="mastery-level">{{ domain.mastery_level }}</span>
                      </div>
                      <p class="domain-story">{{ domain.journey_story }}</p>
                      <div class="technology-grid">
                        {% for tech in domain.core_technologies %}
                          <div class="tech-skill">
                            <div class="skill-info">
                              <span class="skill-name">{{ tech.name }}</span>
                              <span class="skill-proficiency">{{ tech.proficiency }}</span>
                            </div>
                            <div class="skill-experience">{{ tech.experience }}</div>
                          </div>
                        {% endfor %}
                      </div>
                      <div class="recent-applications">
                        <h4>Recent Applications</h4>
                        <ul>
                          {% for app in domain.recent_applications %}
                            <li>{{ app }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

            {% elsif entry.type == 'learning_journey' %}
              <div class="learning-journey">
                <h2 class="section-title">{{ entry.title }}</h2>
                <p class="section-subtitle">{{ entry.subtitle }}</p>
                <div class="learning-categories">
                  {% for category in entry.contents %}
                    <div class="learning-category">
                      <h3>{{ category.category }}</h3>
                      <div class="learning-items">
                        {% for item in category.items %}
                          {% if item.title %}
                            <div class="certification-item">
                              <h4>{{ item.title }}</h4>
                              <span class="provider">{{ item.provider }}</span>
                              <span class="cert-date">{{ item.date }}</span>
                              <p class="relevance">{{ item.relevance }}</p>
                            </div>
                          {% else %}
                            <div class="learning-item">{{ item }}</div>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

            {% elsif entry.type == 'future_vision' %}
              <div class="future-vision">
                <h2 class="section-title">{{ entry.title }}</h2>
                <p class="section-subtitle">{{ entry.subtitle }}</p>
                <div class="vision-grid">
                  {% for item in entry.contents %}
                    <div class="vision-card">
                      <h3>{{ item.philosophy | default: item.current_focus | default: item.community_impact | default: item.long_term_vision | default: item.call_to_action }}</h3>
                      <p>{{ item.description }}</p>
                    </div>
                  {% endfor %}
                </div>
              </div>

            {% elsif entry.type == 'contact_section' %}
              <div class="contact-journey">
                <h2 class="section-title">{{ entry.title }}</h2>
                <div class="contact-content">
                  {% for item in entry.contents %}
                    {% if item.purpose %}
                      <div class="contact-purpose">
                        <h3>{{ item.purpose }}</h3>
                        <p>{{ item.description }}</p>
                      </div>
                    {% elsif item.best_for %}
                      <div class="contact-excited">
                        <h3>{{ item.best_for }}</h3>
                        <ul>
                          {% for excited_item in item.items %}
                            <li>{{ excited_item }}</li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% elsif item.contact_info %}
                      <div class="contact-info">
                        <h3>Contact Information</h3>
                        <div class="contact-links">
                          <a href="mailto:{{ item.contact_info.email }}" class="contact-link">
                            <i class="fa-solid fa-envelope"></i> {{ item.contact_info.email }}
                          </a>
                          <a href="{{ item.contact_info.linkedin }}" target="_blank" class="contact-link">
                            <i class="fa-brands fa-linkedin"></i> LinkedIn Profile
                          </a>
                          <a href="{{ item.contact_info.github }}" target="_blank" class="contact-link">
                            <i class="fa-brands fa-github"></i> GitHub Profile
                          </a>
                          <a href="{{ item.contact_info.portfolio }}" target="_blank" class="contact-link">
                            <i class="fa-solid fa-globe"></i> Portfolio Website
                          </a>
                        </div>
                      </div>
                    {% elsif item.response_commitment %}
                      <div class="contact-commitment">
                        <p><strong>{{ item.response_commitment }}</strong></p>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>

            {% else %}
              <!-- Fallback for other content types -->
              <div class="generic-section">
                <h2 class="section-title">{{ entry.title }}</h2>
                {{ entry.contents }}
              </div>
            {% endif %}
          </section>
        {% endfor %}
      </main>
    </div>
  </div>
{% else %}
  <!-- Fallback to original layout -->
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for data in site.data.resume %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ data[0] | capitalize }}</h3>
            <div>
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}

<style>
/* Professional Journey Styling */
.professional-journey-wrapper {
  --journey-primary: var(--global-theme-color);
  --journey-secondary: var(--global-text-color-light);
  --journey-accent: #f59e0b;
  --journey-success: #10b981;
  --journey-surface: var(--global-card-bg-color);
  --journey-border: var(--global-divider-color);
  margin: 0;
  overflow-x: hidden;
}

/* Hero Section */
.journey-hero {
  position: relative;
  min-height: 70vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: white;
}

.hero-background {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--journey-primary) 0%, #7c3aed 50%, #1e293b 100%);
}

.hero-pattern {
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.05) 0%, transparent 50%);
}

.journey-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem;
  width: 100%;
}

.hero-content {
  max-width: 800px;
}

.hero-badge {
  display: inline-block;
  padding: 0.5rem 1rem;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50px;
  font-size: 0.875rem;
  font-weight: 500;
  margin-bottom: 1.5rem;
  backdrop-filter: blur(10px);
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  font-size: 1.25rem;
  line-height: 1.6;
  margin-bottom: 2.5rem;
  opacity: 0.9;
  max-width: 600px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.875rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 2px solid transparent;
}

.hero-btn.primary {
  background: white;
  color: var(--journey-primary);
}

.hero-btn.secondary {
  background: var(--journey-accent);
  color: white;
}

.hero-btn.ghost {
  background: rgba(255, 255, 255, 0.1);
  color: white;
  border-color: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
}

.hero-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

/* Journey Content Layout */
.journey-body {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 3rem;
  max-width: 1400px;
  margin: 0 auto;
  padding: 3rem 2rem;
  align-items: start;
}

/* Navigation */
.journey-navigation {
  position: sticky;
  top: 6rem;
  background: var(--journey-surface);
  border: 1px solid var(--journey-border);
  border-radius: 16px;
  padding: 1.5rem;
  height: fit-content;
  max-height: calc(100vh - 8rem);
  overflow-y: auto;
}

.nav-header h3 {
  margin: 0 0 1rem 0;
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--global-text-color);
}

.nav-progress {
  height: 4px;
  background: var(--journey-border);
  border-radius: 2px;
  margin-bottom: 1.5rem;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--journey-primary), var(--journey-accent));
  width: 0%;
  transition: width 0.3s ease;
}

.nav-links {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.nav-links a {
  display: block;
  padding: 0.75rem 1rem;
  color: var(--global-text-color-light);
  text-decoration: none;
  border-radius: 8px;
  transition: all 0.2s ease;
  font-size: 0.875rem;
  border-left: 3px solid transparent;
}

.nav-links a:hover,
.nav-links a.active {
  background: rgba(var(--journey-primary-rgb, 181, 9, 172), 0.1);
  color: var(--journey-primary);
  border-left-color: var(--journey-primary);
}

/* Journey Content */
.journey-content {
  min-width: 0;
}

/* Journey Section Connectors */
.journey-section {
  margin-bottom: 5rem;
  scroll-margin-top: 6rem;
  position: relative;
}

.journey-section:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: -2.5rem;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 4px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    var(--journey-primary) 25%, 
    var(--journey-accent) 75%, 
    transparent 100%);
  border-radius: 2px;
}

/* Section Journey Dots */
.section-title::before {
  content: '';
  display: inline-block;
  width: 12px;
  height: 12px;
  background: var(--journey-primary);
  border-radius: 50%;
  margin-right: 1rem;
  border: 3px solid var(--global-bg-color);
  box-shadow: 0 0 0 2px var(--journey-primary);
  vertical-align: middle;
}

.section-title {
  font-size: 2.25rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: var(--global-text-color);
  letter-spacing: -0.02em;
}

.section-subtitle {
  font-size: 1.125rem;
  color: var(--global-text-color-light);
  margin-bottom: 2rem;
  line-height: 1.6;
}

/* Profile Hero */
.profile-hero {
  background: linear-gradient(135deg, var(--journey-surface) 0%, rgba(var(--journey-primary-rgb, 181, 9, 172), 0.05) 100%);
  border: 1px solid var(--journey-border);
  border-radius: 20px;
  padding: 2.5rem;
  margin-bottom: 3rem;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 2rem;
  margin-bottom: 2rem;
}

.profile-avatar {
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, var(--journey-primary), var(--journey-accent));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  font-weight: 700;
  color: white;
}

.profile-name {
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 0.5rem 0;
  color: var(--global-text-color);
}

.profile-title {
  font-size: 1.25rem;
  color: var(--journey-primary);
  font-weight: 600;
  margin: 0 0 1rem 0;
}

.profile-mission {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--global-text-color-light);
