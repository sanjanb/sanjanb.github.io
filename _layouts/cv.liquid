  background: linear-gradient(135deg, var(--journey-surface) 0%, rgba(var(--journey-primary-rgb, 181, 9, 172), 0.05) 100%);
  border: 1px solid var(--journey-border);
  border-radius: 16px;
  padding: 2rem;
  transition: all 0.3s ease;
}

.vision-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
}

.vision-card h3 {
  color: var(--journey-primary);
  margin-bottom: 1rem;
  font-weight: 600;
  font-size: 1.25rem;
}

.vision-card p {
  color: var(--global-text-color-light);
  line-height: 1.6;
}

/* Contact Journey */
.contact-journey {
  margin-bottom: 3rem;
}

.contact-content {
  display: grid;
  gap: 2rem;
}

.contact-purpose,
.contact-excited {
  background: var(--journey-surface);
  border: 1px solid var(--journey-border);
  border-radius: 16px;
  padding: 2rem;
}

.contact-purpose h3,
.contact-excited h3 {
  color: var(--global-text-color);
  margin-bottom: 1rem;
  font-weight: 600;
}

.contact-excited ul {
  list-style: none;
  padding: 0;
}

.contact-excited li {
  padding: 0.75rem;
  background: rgba(var(--journey-primary-rgb, 181, 9, 172), 0.05);
  border-left: 3px solid var(--journey-primary);
  margin-bottom: 0.5rem;
  border-radius: 4px;
}

.contact-info {
  background: linear-gradient(135deg, var(--journey-primary), var(--journey-accent));
  color: white;
  border-radius: 16px;
  padding: 2rem;
}

.contact-info h3 {
  color: white;
  margin-bottom: 1.5rem;
}

.contact-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: white;
  text-decoration: none;
  background: rgba(255, 255, 255, 0.1);
  padding: 1rem;
  border-radius: 12px;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.contact-link:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: translateY(-2px);
}

.contact-commitment {
  background: rgba(var(--journey-success-rgb, 16, 185, 129), 0.1);
  border: 1px solid var(--journey-success);
  border-radius: 12px;
  padding: 1.5rem;
  text-align: center;
}

.contact-commitment p {
  color: var(--journey-success);
  margin: 0;
  font-size: 1.1rem;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .journey-body {
    grid-template-columns: 250px 1fr;
    gap: 2rem;
  }
  
  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  
  .timeline-container::before {
    left: 50px;
  }
  
  .year-label::before {
    left: -35px;
  }
}

@media (max-width: 900px) {
  .journey-body {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .journey-navigation {
    position: relative;
    top: 0;
    max-height: none;
  }
  
  .nav-links {
    flex-direction: row;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  
  .nav-links a {
    flex-shrink: 0;
    white-space: nowrap;
  }
  
  .achievement-year {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  
  .year-label {
    min-width: auto;
    text-align: center;
    margin-bottom: 1rem;
  }
  
  .year-label::before {
    left: 50%;
    top: -25px;
    transform: translateX(-50%);
  }
  
  .achievement-container::before {
    left: 50%;
    transform: translateX(-50%);
  }
  
  .profile-header {
    flex-direction: column;
    text-align: center;
  }
  
  .role-header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .timeline-container::before {
    left: 30px;
  }
  
  .timeline-item {
    flex-direction: column;
  }
  
  .timeline-item:nth-child(even) {
    flex-direction: column;
  }
  
  .timeline-marker {
    width: 60px;
    margin-right: 0;
    margin-bottom: 1rem;
    justify-content: flex-start;
  }
  
  .timeline-item:nth-child(even) .timeline-marker {
    margin-left: 0;
  }
  
  .timeline-content::before {
    display: none;
  }
  
  .timeline-item:nth-child(even) .timeline-content,
  .timeline-item:nth-child(odd) .timeline-content {
    transform: none;
  }
}

@media (max-width: 650px) {
  .journey-hero-inner {
    padding: 3rem 1rem;
  }
  
  .journey-body {
    padding: 2rem 1rem;
  }
  
  .hero-actions {
    flex-direction: column;
  }
  
  .hero-btn {
    justify-content: center;
  }
  
  .timeline-container::before {
    left: 20px;
  }
  
  .timeline-marker {
    width: 40px;
  }
  
  .contact-links {
    grid-template-columns: 1fr;
  }
  
  .achievement-card::before {
    left: -1rem;
  }
}

/* Dark Mode Adjustments */
html[data-theme="dark"] .professional-journey-wrapper {
  --journey-border: var(--global-divider-color);
  --journey-surface: var(--global-card-bg-color);
}

html[data-theme="dark"] .hero-gradient {
  background: linear-gradient(135deg, var(--journey-primary) 0%, #6366f1 50%, #0f172a 100%);
}

html[data-theme="dark"] .metric-item {
  background: rgba(255, 255, 255, 0.05);
}

/* Animation and Interactions */
.journey-section {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease-out forwards;
}

.journey-section:nth-child(2) { animation-delay: 0.1s; }
.journey-section:nth-child(3) { animation-delay: 0.2s; }
.journey-section:nth-child(4) { animation-delay: 0.3s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Scroll Progress */
.journey-navigation .progress-bar {
  animation: progressGrow 1s ease-out 0.5s forwards;
}

@keyframes progressGrow {
  from { width: 0%; }
  to { width: 70%; }
}
</style>

<script>
(function() {
  // Enhanced navigation with scroll progress
  const navigation = document.querySelector('.journey-navigation');
  const navLinks = document.querySelector('.nav-links');
  const progressBar = document.querySelector('.progress-bar');
  
  if (navigation && navLinks) {
    // Build navigation
    const sections = [...document.querySelectorAll('.journey-section')];
    const fragment = document.createDocumentFragment();
    
    sections.forEach(section => {
      const anchor = section.querySelector('.anchor');
      const id = anchor ? anchor.id : section.id || section.getAttribute('data-title')?.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      
      if (!section.id) section.id = id;
      
      const link = document.createElement('a');
      link.href = '#' + id;
      link.textContent = section.getAttribute('data-title') || section.querySelector('.section-title')?.textContent || 'Section';
      fragment.appendChild(link);
    });
    
    navLinks.appendChild(fragment);
    
    // Active section tracking and scroll progress
    const links = [...navLinks.querySelectorAll('a')];
    
    const updateActiveSection = () => {
      const scrollPercent = Math.min(100, (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100);
      if (progressBar) {
        progressBar.style.width = scrollPercent + '%';
      }
      
      let activeSection = null;
      sections.forEach(section => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= window.innerHeight * 0.3 && rect.bottom >= window.innerHeight * 0.3) {
          activeSection = section;
        }
      });
      
      links.forEach(link => {
        const isActive = activeSection && link.getAttribute('href') === '#' + activeSection.id;
        link.classList.toggle('active', isActive);
      });
    };
    
    // Throttled scroll listener
    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActiveSection();
          ticking = false;
        });
        ticking = true;
      }
    };
    
    window.addEventListener('scroll', handleScroll);
    updateActiveSection(); // Initial call
    
    // Smooth scrolling for navigation links
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.querySelector(link.getAttribute('href'));
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  }
  
  // Intersection Observer for staggered animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);
  
  // Observe all animatable elements
  document.querySelectorAll('.journey-section, .phase-card, .timeline-content, .project-card, .achievement-card').forEach(el => {
    observer.observe(el);
  });
})();
</script>
