  border-radius: 4px;
}

/* Career Timeline */
.career-journey {
  margin-bottom: 3rem;
}

.timeline-container {
  position: relative;
  padding: 2rem 0;
}

/* Main Journey Line */
.timeline-container::before {
  content: '';
  position: absolute;
  left: 60px;
  top: 0;
  bottom: 0;
  width: 4px;
  background: linear-gradient(to bottom, 
    var(--journey-primary) 0%, 
    var(--journey-accent) 50%, 
    var(--journey-success) 100%);
  border-radius: 2px;
  z-index: 1;
}

.timeline-item {
  display: flex;
  margin-bottom: 4rem;
  position: relative;
  opacity: 0;
  transform: translateX(-30px);
  animation: slideInTimeline 0.6s ease-out forwards;
}

.timeline-item:nth-child(1) { animation-delay: 0.1s; }
.timeline-item:nth-child(2) { animation-delay: 0.2s; }
.timeline-item:nth-child(3) { animation-delay: 0.3s; }
.timeline-item:nth-child(4) { animation-delay: 0.4s; }
.timeline-item:nth-child(5) { animation-delay: 0.5s; }

@keyframes slideInTimeline {
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.timeline-marker {
  flex-shrink: 0;
  width: 120px;
  position: relative;
  margin-right: 3rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.marker-dot {
  width: 24px;
  height: 24px;
  background: var(--journey-primary);
  border-radius: 50%;
  border: 6px solid var(--global-bg-color);
  box-shadow: 
    0 0 0 3px var(--journey-primary),
    0 4px 12px rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 3;
  transition: all 0.3s ease;
  cursor: pointer;
}

.marker-dot:hover {
  transform: scale(1.2);
  box-shadow: 
    0 0 0 3px var(--journey-primary),
    0 0 20px rgba(var(--journey-primary-rgb, 181, 9, 172), 0.4),
    0 8px 25px rgba(0, 0, 0, 0.2);
}

/* Different colored dots for different phases */
.timeline-item:nth-child(1) .marker-dot {
  background: #10b981; /* Education - Green */
  box-shadow: 0 0 0 3px #10b981, 0 4px 12px rgba(0, 0, 0, 0.15);
}

.timeline-item:nth-child(2) .marker-dot {
  background: #3b82f6; /* Early Career - Blue */
  box-shadow: 0 0 0 3px #3b82f6, 0 4px 12px rgba(0, 0, 0, 0.15);
}

.timeline-item:nth-child(3) .marker-dot {
  background: var(--journey-primary); /* Growth - Primary */
  box-shadow: 0 0 0 3px var(--journey-primary), 0 4px 12px rgba(0, 0, 0, 0.15);
}

.timeline-item:nth-child(4) .marker-dot {
  background: var(--journey-accent); /* Leadership - Accent */
  box-shadow: 0 0 0 3px var(--journey-accent), 0 4px 12px rgba(0, 0, 0, 0.15);
}

.timeline-item:nth-child(5) .marker-dot {
  background: #8b5cf6; /* Innovation - Purple */
  box-shadow: 0 0 0 3px #8b5cf6, 0 4px 12px rgba(0, 0, 0, 0.15);
}

/* Dot pulse animation */
.marker-dot::after {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  background: inherit;
  opacity: 0;
  animation: dotPulse 2s infinite;
}

@keyframes dotPulse {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.3;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

/* Journey Path Curves */
.timeline-item:nth-child(even) {
  flex-direction: row-reverse;
}

.timeline-item:nth-child(even) .timeline-marker {
  margin-left: 3rem;
  margin-right: 0;
}

.timeline-item:nth-child(even) .timeline-content {
  transform: translateX(30px);
}

.timeline-item:nth-child(odd) .timeline-content {
  transform: translateX(-30px);
}

/* Connecting Path Lines */
.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 60px;
  top: 100%;
  width: 4px;
  height: 2rem;
  background: linear-gradient(to bottom, 
    var(--journey-primary) 0%, 
    transparent 100%);
  border-radius: 2px;
  z-index: 2;
}

.timeline-content {
  flex: 1;
  background: var(--journey-surface);
  border: 1px solid var(--journey-border);
  border-radius: 20px;
  padding: 2.5rem;
  transition: all 0.4s ease;
  position: relative;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.timeline-content:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  border-color: var(--journey-primary);
}

/* Journey Content Arrows */
.timeline-content::before {
  content: '';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border: 15px solid transparent;
}

.timeline-item:nth-child(odd) .timeline-content::before {
  left: -30px;
  border-right-color: var(--journey-surface);
}

.timeline-item:nth-child(even) .timeline-content::before {
  right: -30px;
  border-left-color: var(--journey-surface);
}

.timeline-content:hover::before {
  border-right-color: var(--journey-surface);
  border-left-color: var(--journey-surface);
}

