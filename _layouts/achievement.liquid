---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.hero %}
    {% include hero_heading.liquid %}
  {% else %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.organization or page.date %}
        <p class="post-meta">
          {% if page.organization %}
            {{ page.organization }}
          {% endif %}
          {% if page.organization and page.date %} &nbsp;&middot;&nbsp; {% endif %}
          {% if page.date %}
            {{ page.date | date: '%B %Y' }}
          {% endif %}
        </p>
      {% endif %}

    {% if page.start_date or page.end_date or page.rating %}
      <p class="post-meta">
        {% if page.start_date %}
          <i class="fa-solid fa-play fa-sm" style="color: var(--global-tip-block) !important"></i> <em>{{ page.start_date | date: '%B %Y' }}</em>
        {% endif %}
        {% if page.end_date %}
          {% if page.start_date %}
            &nbsp;&middot;&nbsp;
          {% endif %}
          {% if page.status == 'ongoing' %}
            <i class="fa-solid fa-clock fa-sm" style="color: #f39c12 !important"></i> <em>Present</em>
          {% else %}
            <i class="fa-solid fa-stop fa-sm" style="color: #e56565 !important"></i> <em>{{ page.end_date | date: '%B %Y' }}</em>
          {% endif %}
        {% endif %}
        {% if page.rating %}
          {% if page.start_date or page.end_date %}
            &nbsp;&middot;&nbsp;
          {% endif %}
          {% assign full_stars = page.rating | floor %}
          {% assign half_star = page.rating | minus: full_stars %}
          {% assign empty_stars = 5 | minus: full_stars %}
          {% if half_star > 0 %}
            {% assign empty_stars = empty_stars | minus: 1 %}
          {% endif %}
          {% for i in (1..full_stars) -%}
            <i class="fa-solid fa-star fa-sm"></i>
          {%- endfor -%}
          {%- if half_star > 0 %}<i class="fa-solid fa-star-half-stroke fa-sm"></i>{% endif -%}
          {%- for i in (1..empty_stars) -%}
            <i class="fa-regular fa-star fa-sm"></i>
          {%- endfor -%}
        {% endif %}
        {% if page.link %}
          {% if page.start_date or page.end_date or page.rating %}
            &nbsp;&middot;&nbsp;
          {% endif %}
          <a target="_blank" href="{{ page.link }}"><i class="fa-solid fa-external-link-alt fa-sm"></i></a>
        {% endif %}
      </p>
    {% endif %}
    
    <p class="post-tags">
      <a href="{{ year | prepend: '/achievements/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}</a>
      {% if tags != '' %}
        &nbsp;&middot;&nbsp;
        {% for tag in page.tags %}
          <a href="{{ tag | slugify | prepend: '/achievements/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp;&middot;&nbsp;
        {% for category in page.categories %}
          <a href="{{ category | slugify | prepend: '/achievements/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category }}</a>
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
      <hr>
    </header>
  {% endif %}

  <article class="achievement-content">
    {% if page.summary %}
      <div class="achievement-summary">
        <p><strong>{{ page.summary }}</strong></p>
      </div>
    {% endif %}

    {{ content }}
    
    {% if page.metrics %}
      <div class="achievement-metrics">
        <h4>Key Metrics</h4>
        <ul>
          {% for metric in page.metrics %}
            <li><strong>{{ metric.value }}</strong> - {{ metric.label }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
    
    {% if page.skills %}
      <div class="achievement-skills">
        <h4>Skills & Technologies</h4>
        <p>
          {% for skill in page.skills %}
            <code>{{ skill }}</code>{% unless forloop.last %}, {% endunless %}
          {% endfor %}
        </p>
      </div>
    {% endif %}
  </article>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>


