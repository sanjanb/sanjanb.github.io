<style>
/* Voyage Page Styling */
.professional-journey-page {
  margin: 0;
  overflow-x: hidden;
}

    /* Hero Section */
    .journey-hero {
      position: relative;
      min-height: 35vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      color: white;
      margin-top: -1.5rem;
    }.hero-background {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--global-theme-color) 0%, var(--global-hover-color) 100%);
}

.journey-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 800px;
  margin: 0 auto;
  padding: 1.5rem 1.5rem;
  width: 100%;
  text-align: center;
}

.hero-content {
  max-width: 500px;
  margin: 0 auto;
}

.hero-badge {
  display: inline-block;
  padding: 0.25rem 0.6rem;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50px;
  font-size: 0.7rem;
  font-weight: 500;
  margin-bottom: 0.8rem;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.hero-title {
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 0.6rem;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  font-size: clamp(0.9rem, 2vw, 1rem);
  line-height: 1.4;
  margin-bottom: 1.2rem;
  opacity: 0.9;
  max-width: 400px;
  margin-left: auto;
  margin-right: auto;
}

.hero-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1rem;
  border-radius: 0.4rem;
  font-weight: 600;
  font-size: 0.8rem;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 2px solid transparent;
  min-width: 100px;
  justify-content: center;
}

.hero-btn.primary {
  background: var(--global-hover-text-color);
  color: var(--global-theme-color);
  border-color: var(--global-hover-text-color);
}

.hero-btn.ghost {
  background: transparent;
  color: white;
  border-color: rgba(255, 255, 255, 0.5);
}

.hero-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}

.hero-btn.primary:hover {
  background: var(--global-hover-color);
  color: white;
  border-color: var(--global-hover-color);
}

.hero-btn.ghost:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: white;
}

    /* Interactive Statistics Section */
    .journey-stats-section {
      padding: 2rem 0;
      background: linear-gradient(135deg, 
        rgba(var(--global-theme-color-rgb, 181, 9, 172), 0.03) 0%, 
        rgba(var(--global-hover-color-rgb, 181, 9, 172), 0.06) 100%);
      border-top: 1px solid var(--global-divider-color);
      border-bottom: 1px solid var(--global-divider-color);
      position: relative;
      overflow: hidden;
    }

    /* Subtle floating animation background */
    .journey-stats-section::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(var(--global-theme-color-rgb, 181, 9, 172), 0.02) 0%, transparent 70%);
      animation: float 8s ease-in-out infinite;
      z-index: 0;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      33% { transform: translate(-20px, -10px) rotate(120deg); }
      66% { transform: translate(20px, 10px) rotate(240deg); }
    }

    .stats-grid {
      position: relative;
      z-index: 1;
    }    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.8rem;
      max-width: 800px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* Staggered animation for stat cards */
    .stat-card {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
    }

    .stat-card:nth-child(1) { animation-delay: 0.1s; }
    .stat-card:nth-child(2) { animation-delay: 0.2s; }
    .stat-card:nth-child(3) { animation-delay: 0.3s; }
    .stat-card:nth-child(4) { animation-delay: 0.4s; }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 0.9;
        transform: translateY(0);
      }
    }    .stat-card {
      text-align: center;
      padding: 1rem 0.6rem;
      background: var(--global-card-bg-color);
      border-radius: 0.4rem;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid var(--global-divider-color);
      transform: translateY(0);
      opacity: 0.9;
    }

    .stat-card:hover {
      transform: translateY(-3px) scale(1.01);
      box-shadow: 0 6px 20px rgba(var(--global-theme-color-rgb, 181, 9, 172), 0.1);
      opacity: 1;
      border-color: var(--global-theme-color);
    }

    .stat-icon {
      font-size: 1.4rem;
      color: var(--global-theme-color);
      margin-bottom: 0.5rem;
      transition: all 0.3s ease;
      animation: iconPulse 2s ease-in-out infinite;
    }

    .stat-card:hover .stat-icon {
      transform: scale(1.05);
      color: var(--global-hover-color);
    }

    @keyframes iconPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    @keyframes countUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .stat-number {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--global-text-color);
      margin-bottom: 0.3rem;
      line-height: 1;
      transition: all 0.3s ease;
      animation: countUp 0.6s ease-out;
    }

    .stat-card:hover .stat-number {
      color: var(--global-theme-color);
      transform: scale(1.03);
    }

    .stat-label {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--global-text-color);
      margin-bottom: 0.15rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      transition: color 0.3s ease;
    }

    .stat-card:hover .stat-label {
      color: var(--global-theme-color);
    }

    .stat-description {
      font-size: 0.6rem;
      color: var(--global-text-color-light);
      line-height: 1.2;
      transition: all 0.3s ease;
      opacity: 0.8;
    }

    .stat-card:hover .stat-description {
      opacity: 1;
      color: var(--global-text-color);
    }

/* Timeline Section */
.journey-timeline-section {
  padding: 3rem 0;
  background: var(--global-bg-color);
}

.container {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h2 {
  font-size: clamp(1.75rem, 4vw, 2.25rem);
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--global-text-color);
}

.section-header p {
  font-size: 1rem;
  color: var(--global-text-color-light);
  max-width: 500px;
  margin: 0 auto;
}

/* Timeline Structure */
.journey-timeline {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem 0;
}

/* Central Timeline Line */
.journey-timeline::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3px;
  background: linear-gradient(to bottom, 
    var(--global-theme-color) 0%, 
    var(--global-hover-color) 100%);
  transform: translateX(-50%);
  border-radius: 2px;
  z-index: 1;
}

/* Timeline Milestones */
.timeline-milestone {
  position: relative;
  margin-bottom: 3rem;
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease-out forwards;
}

.timeline-milestone:nth-child(1) { animation-delay: 0.1s; }
.timeline-milestone:nth-child(2) { animation-delay: 0.2s; }
.timeline-milestone:nth-child(3) { animation-delay: 0.3s; }
.timeline-milestone:nth-child(4) { animation-delay: 0.4s; }
.timeline-milestone:nth-child(5) { animation-delay: 0.5s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Alternating Layout */
.timeline-milestone:nth-child(odd) {
  padding-right: 50%;
  text-align: left;
}

.timeline-milestone:nth-child(even) {
  padding-left: 50%;
  text-align: right;
}

.timeline-milestone:nth-child(odd) .milestone-content {
  margin-right: 2rem;
}

.timeline-milestone:nth-child(even) .milestone-content {
  margin-left: 2rem;
}

/* Milestone Markers */
.milestone-marker {
  position: absolute;
  left: 50%;
  top: 1.5rem;
  transform: translateX(-50%);
  display: flex;
