---
layout: default
---

<div class="professional-journey-page">
  <!-- Hero Section -->
  <section class="journey-hero">
    <div class="hero-background">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
    </div>
    <div class="journey-hero-inner">
      <div class="hero-content">
        <span class="hero-badge">Professional Journey</span>
        <h1 class="hero-title">From Vision to Impact</h1>
        <p class="hero-subtitle">
          Discover the story behind my evolution from a curious computer science student 
          to an AI engineering leader, marked by continuous learning, innovation, and 
          meaningful contributions to technology.
        </p>
        <div class="hero-actions">
          <a href="#timeline" class="hero-btn primary">
            <i class="fas fa-route"></i>
            Explore Journey
          </a>
          <a href="/cv/" class="hero-btn ghost">
            <i class="fas fa-file-alt"></i>
            View CV
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Statistics -->
  <section class="journey-stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card" data-aos="fade-up" data-aos-delay="100">
          <div class="stat-icon">
            <i class="fas fa-calendar-alt"></i>
          </div>
          <div class="stat-number" data-target="5">0</div>
          <div class="stat-label">Years of Experience</div>
          <div class="stat-description">Since starting freelance development</div>
        </div>

        <div class="stat-card" data-aos="fade-up" data-aos-delay="200">
          <div class="stat-icon">
            <i class="fas fa-code"></i>
          </div>
          <div class="stat-number" data-target="50">0</div>
          <div class="stat-label">Projects Completed</div>
          <div class="stat-description">Across web dev, AI, and research</div>
        </div>

        <div class="stat-card" data-aos="fade-up" data-aos-delay="300">
          <div class="stat-icon">
            <i class="fas fa-tools"></i>
          </div>
          <div class="stat-number" data-target="25">0</div>
          <div class="stat-label">Technologies Mastered</div>
          <div class="stat-description">From MERN to Vision AI models</div>
        </div>

        <div class="stat-card" data-aos="fade-up" data-aos-delay="400">
          <div class="stat-icon">
            <i class="fas fa-git-alt"></i>
          </div>
          <div class="stat-number" data-target="100">0</div>
          <div class="stat-label">Open Source Contributions</div>
          <div class="stat-description">Pull requests and collaborations</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Journey Timeline -->
  <section class="journey-timeline-section" id="timeline">
    <div class="container">
      <div class="section-header">
        <h2>My Professional Timeline</h2>
        <p>Key milestones that shaped my career and expertise</p>
      </div>

      <div class="journey-timeline">
        <!-- Timeline items will be populated here -->
        
        <!-- Current Role -->
        <div class="timeline-milestone" data-year="2025">
          <div class="milestone-marker">
            <div class="marker-dot innovation"></div>
            <div class="marker-label">Vision AI</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Vision Language Model Intern</h3>
              <h4>SynerSense®</h4>
              <p class="period">Jun 2025 - Present</p>
              <p class="description">
                Working on cutting-edge vision language models in a hybrid environment. 
                Documenting weekly progress and exploring research applications in computer vision and NLP integration.
              </p>
              <div class="skills">
                <span class="skill-tag">Vision Language Models</span>
                <span class="skill-tag">Computer Vision</span>
                <span class="skill-tag">Research</span>
              </div>
            </div>
          </div>
        </div>

        <!-- AI Agriculture Project -->
        <div class="timeline-milestone" data-year="2025">
          <div class="milestone-marker">
            <div class="marker-dot growth"></div>
            <div class="marker-label">AI Agriculture</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Project Intern - AI in Agriculture</h3>
              <h4>IEEE Computer Society Bangalore Chapter</h4>
              <p class="period">Apr 2025 - Sep 2025</p>
              <p class="description">
                Developed AI-driven precision farming tools for crop yield optimization and pest detection systems. 
                Analyzed cases where AI reduced manual labor by 40% and increased crop output.
              </p>
              <div class="skills">
                <span class="skill-tag">Deep Learning</span>
                <span class="skill-tag">Agricultural AI</span>
                <span class="skill-tag">Image Recognition</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Leadership Role -->
        <div class="timeline-milestone" data-year="2024">
          <div class="milestone-marker">
            <div class="marker-dot leadership"></div>
            <div class="marker-label">Leadership</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Vice Chair</h3>
              <h4>IEEE ATMECE</h4>
              <p class="period">Sep 2024 - Present</p>
              <p class="description">
                Leading events and workshops to enhance member skills and foster industry connections. 
                Organizing networking opportunities and collaborating with industry professionals.
              </p>
              <div class="skills">
                <span class="skill-tag">Team Leadership</span>
                <span class="skill-tag">Event Planning</span>
                <span class="skill-tag">Professional Development</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Open Source Contributions -->
        <div class="timeline-milestone" data-year="2024">
          <div class="milestone-marker">
            <div class="marker-dot career"></div>
            <div class="marker-label">Open Source</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Open Source Contributor</h3>
              <h4>SWOC & GirlScript Winter of Contributing</h4>
              <p class="period">Sep 2024 - Feb 2025</p>
              <p class="description">
                Contributed to blockchain projects and dApps, collaborating with global teams to enhance 
                security and optimize transaction efficiency. Made significant impacts through pull requests.
              </p>
              <div class="skills">
                <span class="skill-tag">Blockchain</span>
                <span class="skill-tag">Smart Contracts</span>
                <span class="skill-tag">Collaboration</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Data Science Journey -->
        <div class="timeline-milestone" data-year="2024">
          <div class="milestone-marker">
            <div class="marker-dot growth"></div>
            <div class="marker-label">Data Science</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Kaggler & Data Science Enthusiast</h3>
              <h4>Kaggle Platform</h4>
              <p class="period">Apr 2024 - Present</p>
              <p class="description">
                Exploring real-world data problems to sharpen machine learning skills. 
                Practicing classification, regression, and clustering while learning from top data science minds.
              </p>
              <div class="skills">
                <span class="skill-tag">Machine Learning</span>
                <span class="skill-tag">Data Analysis</span>
                <span class="skill-tag">Python</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Business Development Experience -->
        <div class="timeline-milestone" data-year="2025">
          <div class="milestone-marker">
            <div class="marker-dot career"></div>
            <div class="marker-label">Business</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Business Development Specialist</h3>
              <h4>Younity.in</h4>
              <p class="period">Feb 2025</p>
              <p class="description">
                Strategized growth and built sustainable revenue systems for B2C & B2B communication. 
                Demonstrated strong communication and leadership skills in remote work environment.
              </p>
              <div class="skills">
                <span class="skill-tag">Business Strategy</span>
                <span class="skill-tag">Communication</span>
                <span class="skill-tag">Leadership</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Journalism Experience -->
        <div class="timeline-milestone" data-year="2022-2023">
          <div class="milestone-marker">
            <div class="marker-dot education"></div>
            <div class="marker-label">Media</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>News Editor & Reporter</h3>
              <h4>Thirthahalli Bandhu</h4>
              <p class="period">Oct 2022 - May 2023</p>
              <p class="description">
                Spearheaded community-centric journalism initiatives, crafting compelling narratives 
                and leading teams to deliver timely, impactful news updates.
              </p>
              <div class="skills">
                <span class="skill-tag">Adobe Premiere Pro</span>
                <span class="skill-tag">Content Creation</span>
                <span class="skill-tag">Team Leadership</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Freelance Journey -->
        <div class="timeline-milestone" data-year="2020">
          <div class="milestone-marker">
            <div class="marker-dot career"></div>
            <div class="marker-label">Freelance</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Freelance Web Developer</h3>
              <h4>Upwork</h4>
              <p class="period">Jul 2020 - Present</p>
              <p class="description">
                Developing responsive web applications using MERN stack with secure authentication. 
                Delivering client projects with cloud deployments and achieving high client satisfaction.
              </p>
              <div class="skills">
                <span class="skill-tag">MERN Stack</span>
                <span class="skill-tag">Next.js</span>
                <span class="skill-tag">Cloud Deployment</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Achievements -->
  <section class="journey-achievements">
    <div class="container">
      <h2>Key Achievements</h2>
      <div class="achievements-grid">
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-trophy"></i>
          </div>
          <h3>Hackathon Winner</h3>
          <p>Won multiple hackathons including national-level competitions</p>
        </div>
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-users"></i>
          </div>
          <h3>Community Leader</h3>
          <p>Led technical communities and mentored upcoming developers</p>
        </div>
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-code"></i>
          </div>
          <h3>Open Source</h3>
          <p>Contributed to various open-source projects and initiatives</p>
        </div>
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-brain"></i>
          </div>
          <h3>AI Innovation</h3>
          <p>Developed cutting-edge AI solutions with real-world impact</p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
/* Professional Journey Page Styling */
.professional-journey-page {
  margin: 0;
  overflow-x: hidden;
}

    /* Hero Section */
    .journey-hero {
      position: relative;
      min-height: 35vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      color: white;
      margin-top: -1.5rem;
    }.hero-background {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--global-theme-color) 0%, var(--global-hover-color) 100%);
}

.journey-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 800px;
  margin: 0 auto;
  padding: 1.5rem 1.5rem;
  width: 100%;
  text-align: center;
}

.hero-content {
  max-width: 500px;
  margin: 0 auto;
}

.hero-badge {
  display: inline-block;
  padding: 0.25rem 0.6rem;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50px;
  font-size: 0.7rem;
  font-weight: 500;
  margin-bottom: 0.8rem;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.hero-title {
  font-size: clamp(1.5rem, 4vw, 2.2rem);
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 0.6rem;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  font-size: clamp(0.9rem, 2vw, 1rem);
  line-height: 1.4;
  margin-bottom: 1.2rem;
  opacity: 0.9;
  max-width: 400px;
  margin-left: auto;
  margin-right: auto;
}

.hero-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1rem;
  border-radius: 0.4rem;
  font-weight: 600;
  font-size: 0.8rem;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 2px solid transparent;
  min-width: 100px;
  justify-content: center;
}

.hero-btn.primary {
  background: var(--global-hover-text-color);
  color: var(--global-theme-color);
  border-color: var(--global-hover-text-color);
}

.hero-btn.ghost {
  background: transparent;
  color: white;
  border-color: rgba(255, 255, 255, 0.5);
}

.hero-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}

.hero-btn.primary:hover {
  background: var(--global-hover-color);
  color: white;
  border-color: var(--global-hover-color);
}

.hero-btn.ghost:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: white;
}

    /* Interactive Statistics Section */
    .journey-stats-section {
      padding: 2.5rem 0;
      background: linear-gradient(135deg, 
        rgba(var(--global-theme-color-rgb, 181, 9, 172), 0.03) 0%, 
        rgba(var(--global-hover-color-rgb, 181, 9, 172), 0.06) 100%);
      border-top: 1px solid var(--global-divider-color);
      border-bottom: 1px solid var(--global-divider-color);
      position: relative;
      overflow: hidden;
    }

    /* Subtle floating animation background */
    .journey-stats-section::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(var(--global-theme-color-rgb, 181, 9, 172), 0.02) 0%, transparent 70%);
      animation: float 8s ease-in-out infinite;
      z-index: 0;
    }

    @keyframes float {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      33% { transform: translate(-20px, -10px) rotate(120deg); }
      66% { transform: translate(20px, 10px) rotate(240deg); }
    }

    .stats-grid {
      position: relative;
      z-index: 1;
    }    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.5rem;
      max-width: 750px;
      margin: 0 auto;
    }

    /* Staggered animation for stat cards */
    .stat-card {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
    }

    .stat-card:nth-child(1) { animation-delay: 0.1s; }
    .stat-card:nth-child(2) { animation-delay: 0.2s; }
    .stat-card:nth-child(3) { animation-delay: 0.3s; }
    .stat-card:nth-child(4) { animation-delay: 0.4s; }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 0.9;
        transform: translateY(0);
      }
    }    .stat-card {
      text-align: center;
      padding: 1.25rem 0.75rem;
      background: var(--global-card-bg-color);
      border-radius: 0.5rem;
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.04);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid var(--global-divider-color);
      transform: translateY(0);
      opacity: 0.9;
    }

    .stat-card:hover {
      transform: translateY(-4px) scale(1.02);
      box-shadow: 0 8px 25px rgba(var(--global-theme-color-rgb, 181, 9, 172), 0.12);
      opacity: 1;
      border-color: var(--global-theme-color);
    }

    .stat-icon {
      font-size: 1.6rem;
      color: var(--global-theme-color);
      margin-bottom: 0.6rem;
      transition: all 0.3s ease;
      animation: iconPulse 2s ease-in-out infinite;
    }

    .stat-card:hover .stat-icon {
      transform: scale(1.1);
      color: var(--global-hover-color);
    }

    @keyframes iconPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    @keyframes countUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .stat-number {
      font-size: 2rem;
      font-weight: 700;
      color: var(--global-text-color);
      margin-bottom: 0.4rem;
      line-height: 1;
      transition: all 0.3s ease;
      animation: countUp 0.6s ease-out;
    }

    .stat-card:hover .stat-number {
      color: var(--global-theme-color);
      transform: scale(1.05);
    }

    .stat-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--global-text-color);
      margin-bottom: 0.2rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      transition: color 0.3s ease;
    }

    .stat-card:hover .stat-label {
      color: var(--global-theme-color);
    }

    .stat-description {
      font-size: 0.7rem;
      color: var(--global-text-color-light);
      line-height: 1.3;
      transition: all 0.3s ease;
      opacity: 0.8;
    }

    .stat-card:hover .stat-description {
      opacity: 1;
      color: var(--global-text-color);
    }

/* Timeline Section */
.journey-timeline-section {
  padding: 3rem 0;
  background: var(--global-bg-color);
}

.container {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h2 {
  font-size: clamp(1.75rem, 4vw, 2.25rem);
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--global-text-color);
}

.section-header p {
  font-size: 1rem;
  color: var(--global-text-color-light);
  max-width: 500px;
  margin: 0 auto;
}

/* Timeline Structure */
.journey-timeline {
  position: relative;
  max-width: 700px;
  margin: 0 auto;
  padding: 1.5rem 0;
}

/* Central Timeline Line */
.journey-timeline::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 3px;
  background: linear-gradient(to bottom, 
    var(--global-theme-color) 0%, 
    var(--global-hover-color) 100%);
  transform: translateX(-50%);
  border-radius: 2px;
  z-index: 1;
}

/* Timeline Milestones */
.timeline-milestone {
  position: relative;
  margin-bottom: 3rem;
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease-out forwards;
}

.timeline-milestone:nth-child(1) { animation-delay: 0.1s; }
.timeline-milestone:nth-child(2) { animation-delay: 0.2s; }
.timeline-milestone:nth-child(3) { animation-delay: 0.3s; }
.timeline-milestone:nth-child(4) { animation-delay: 0.4s; }
.timeline-milestone:nth-child(5) { animation-delay: 0.5s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Alternating Layout */
.timeline-milestone:nth-child(odd) {
  padding-right: 50%;
}

.timeline-milestone:nth-child(even) {
  padding-left: 50%;
  text-align: right;
}

.timeline-milestone:nth-child(odd) .milestone-content {
  margin-right: 1.5rem;
}

.timeline-milestone:nth-child(even) .milestone-content {
  margin-left: 1.5rem;
}

/* Milestone Markers */
.milestone-marker {
  position: absolute;
  left: 50%;
  top: 1.5rem;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}

.marker-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 3px solid var(--global-bg-color);
  box-shadow: 0 0 0 3px currentColor;
  transition: all 0.3s ease;
  margin-bottom: 0.5rem;
}

.marker-dot.education {
  background: var(--global-theme-color);
  color: var(--global-theme-color);
}

.marker-dot.career {
  background: var(--global-hover-color);
  color: var(--global-hover-color);
}

.marker-dot.growth {
  background: var(--global-theme-color);
  color: var(--global-theme-color);
}

.marker-dot.leadership {
  background: var(--global-hover-color);
  color: var(--global-hover-color);
}

.marker-dot.innovation {
  background: var(--global-theme-color);
  color: var(--global-theme-color);
}

.marker-label {
  background: var(--global-card-bg-color);
  color: var(--global-text-color);
  padding: 0.25rem 0.625rem;
  border-radius: 12px;
  font-size: 0.7rem;
  font-weight: 600;
  border: 1px solid var(--global-divider-color);
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.timeline-milestone:hover .marker-dot {
  transform: scale(1.15);
}

/* Content Cards */
.content-card {
  background: var(--global-card-bg-color);
  border: 1px solid var(--global-divider-color);
  border-radius: 0.75rem;
  padding: 1.5rem;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

.content-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  border-color: var(--global-theme-color);
}

/* Content Card Arrows */
.timeline-milestone:nth-child(odd) .content-card::after {
  content: '';
  position: absolute;
  right: -10px;
  top: 1.5rem;
  width: 0;
  height: 0;
  border: 10px solid transparent;
  border-left-color: var(--global-card-bg-color);
}

.timeline-milestone:nth-child(even) .content-card::after {
  content: '';
  position: absolute;
  left: -10px;
  top: 1.5rem;
  width: 0;
  height: 0;
  border: 10px solid transparent;
  border-right-color: var(--global-card-bg-color);
}

.content-card h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--global-text-color);
}

.content-card h4 {
  font-size: 1rem;
  color: var(--global-theme-color);
  margin-bottom: 0.375rem;
  font-weight: 500;
}

.period {
  color: var(--global-text-color-light);
  font-size: 0.8rem;
