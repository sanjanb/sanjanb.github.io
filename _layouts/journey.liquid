---
layout: default
---

<div class="professional-journey-page">
  <!-- Hero Section -->
  <section class="journey-hero">
    <div class="hero-background">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
    </div>
    <div class="journey-hero-inner">
      <div class="hero-content">
        <span class="hero-badge">Professional Journey</span>
        <h1 class="hero-title">From Vision to Impact</h1>
        <p class="hero-subtitle">
          Discover the story behind my evolution from a curious computer science student 
          to an AI engineering leader, marked by continuous learning, innovation, and 
          meaningful contributions to technology.
        </p>
        <div class="hero-actions">
          <a href="#timeline" class="hero-btn primary">
            <i class="fas fa-route"></i>
            Explore Journey
          </a>
          <a href="/cv/" class="hero-btn ghost">
            <i class="fas fa-file-alt"></i>
            View CV
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Journey Timeline -->
  <section class="journey-timeline-section" id="timeline">
    <div class="container">
      <div class="section-header">
        <h2>My Professional Timeline</h2>
        <p>Key milestones that shaped my career and expertise</p>
      </div>

      <div class="journey-timeline">
        <!-- Timeline items will be populated here -->
        
        <!-- Education Phase -->
        <div class="timeline-milestone" data-year="2018-2022">
          <div class="milestone-marker">
            <div class="marker-dot education"></div>
            <div class="marker-label">Education</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Computer Science Engineering</h3>
              <h4>Nitte Meenakshi Institute of Technology</h4>
              <p class="period">2018 - 2022</p>
              <p class="description">
                Built strong foundations in software engineering, algorithms, and data structures. 
                Developed passion for AI/ML and participated in various technical competitions.
              </p>
              <div class="achievements">
                <span class="achievement-tag">CGPA: 8.5</span>
                <span class="achievement-tag">Technical Lead</span>
                <span class="achievement-tag">Hackathon Winner</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Early Career -->
        <div class="timeline-milestone" data-year="2022">
          <div class="milestone-marker">
            <div class="marker-dot career"></div>
            <div class="marker-label">First Role</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Software Engineer</h3>
              <h4>Entry Level Position</h4>
              <p class="period">2022</p>
              <p class="description">
                Started professional journey with hands-on experience in software development, 
                learning industry best practices and working with cross-functional teams.
              </p>
              <div class="skills">
                <span class="skill-tag">Java</span>
                <span class="skill-tag">Python</span>
                <span class="skill-tag">Web Development</span>
                <span class="skill-tag">Team Collaboration</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Growth Phase -->
        <div class="timeline-milestone" data-year="2023">
          <div class="milestone-marker">
            <div class="marker-dot growth"></div>
            <div class="marker-label">Growth</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>AI/ML Specialization</h3>
              <h4>Advanced Development Role</h4>
              <p class="period">2023</p>
              <p class="description">
                Transitioned into AI/ML domain, working on machine learning models and 
                intelligent systems. Gained expertise in deep learning frameworks and MLOps.
              </p>
              <div class="skills">
                <span class="skill-tag">TensorFlow</span>
                <span class="skill-tag">PyTorch</span>
                <span class="skill-tag">MLOps</span>
                <span class="skill-tag">Data Science</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Leadership Phase -->
        <div class="timeline-milestone" data-year="2024">
          <div class="milestone-marker">
            <div class="marker-dot leadership"></div>
            <div class="marker-label">Leadership</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>Technical Leadership</h3>
              <h4>Senior AI Engineer</h4>
              <p class="period">2024</p>
              <p class="description">
                Stepped into leadership roles, mentoring junior developers and architecting 
                complex AI systems. Led cross-functional projects with significant business impact.
              </p>
              <div class="skills">
                <span class="skill-tag">System Architecture</span>
                <span class="skill-tag">Team Leadership</span>
                <span class="skill-tag">Project Management</span>
                <span class="skill-tag">Mentoring</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Current/Future -->
        <div class="timeline-milestone" data-year="2025">
          <div class="milestone-marker">
            <div class="marker-dot innovation"></div>
            <div class="marker-label">Innovation</div>
          </div>
          <div class="milestone-content">
            <div class="content-card">
              <h3>AI Innovation Leader</h3>
              <h4>Current Focus</h4>
              <p class="period">2025 & Beyond</p>
              <p class="description">
                Driving innovation in AI technologies, building next-generation intelligent systems, 
                and contributing to the advancement of artificial intelligence in practical applications.
              </p>
              <div class="skills">
                <span class="skill-tag">AI Research</span>
                <span class="skill-tag">Innovation</span>
                <span class="skill-tag">Strategic Planning</span>
                <span class="skill-tag">Thought Leadership</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Achievements -->
  <section class="journey-achievements">
    <div class="container">
      <h2>Key Achievements</h2>
      <div class="achievements-grid">
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-trophy"></i>
          </div>
          <h3>Hackathon Winner</h3>
          <p>Won multiple hackathons including national-level competitions</p>
        </div>
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-users"></i>
          </div>
          <h3>Community Leader</h3>
          <p>Led technical communities and mentored upcoming developers</p>
        </div>
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-code"></i>
          </div>
          <h3>Open Source</h3>
          <p>Contributed to various open-source projects and initiatives</p>
        </div>
        <div class="achievement-card">
          <div class="achievement-icon">
            <i class="fas fa-brain"></i>
          </div>
          <h3>AI Innovation</h3>
          <p>Developed cutting-edge AI solutions with real-world impact</p>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
/* Professional Journey Page Styling */
.professional-journey-page {
  --journey-primary: var(--global-theme-color);
  --journey-secondary: var(--global-text-color-light);
  --journey-accent: #f59e0b;
  --journey-success: #10b981;
  --journey-surface: var(--global-card-bg-color);
  --journey-border: var(--global-divider-color);
  margin: 0;
  overflow-x: hidden;
}

/* Hero Section */
.journey-hero {
  position: relative;
  min-height: 80vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: white;
}

.hero-background {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--journey-primary) 0%, #7c3aed 50%, #1e293b 100%);
}

.hero-pattern {
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.05) 0%, transparent 50%);
}

.journey-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem;
  width: 100%;
}

.hero-content {
  max-width: 700px;
}

.hero-badge {
  display: inline-block;
  padding: 0.5rem 1rem;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50px;
  font-size: 0.875rem;
  font-weight: 500;
  margin-bottom: 1.5rem;
  backdrop-filter: blur(10px);
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  font-size: 1.25rem;
  line-height: 1.6;
  margin-bottom: 2.5rem;
  opacity: 0.9;
  max-width: 600px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.875rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 2px solid transparent;
}

.hero-btn.primary {
  background: white;
  color: var(--journey-primary);
}

.hero-btn.ghost {
  background: rgba(255, 255, 255, 0.1);
  color: white;
  border-color: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
}

.hero-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

/* Timeline Section */
.journey-timeline-section {
  padding: 5rem 0;
  background: var(--global-bg-color);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.section-header {
  text-align: center;
  margin-bottom: 4rem;
}

.section-header h2 {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: var(--global-text-color);
}

.section-header p {
  font-size: 1.25rem;
  color: var(--global-text-color-light);
}

/* Timeline Structure */
.journey-timeline {
  position: relative;
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 0;
}

/* Central Timeline Line */
.journey-timeline::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4px;
  background: linear-gradient(to bottom, 
    #10b981 0%, 
    var(--journey-primary) 25%, 
    var(--journey-accent) 50%, 
    #8b5cf6 75%, 
    #ec4899 100%);
  transform: translateX(-50%);
  border-radius: 2px;
  z-index: 1;
}

/* Timeline Milestones */
.timeline-milestone {
  position: relative;
  margin-bottom: 4rem;
  opacity: 0;
  transform: translateY(30px);
  animation: fadeInUp 0.6s ease-out forwards;
}

.timeline-milestone:nth-child(1) { animation-delay: 0.1s; }
.timeline-milestone:nth-child(2) { animation-delay: 0.2s; }
.timeline-milestone:nth-child(3) { animation-delay: 0.3s; }
.timeline-milestone:nth-child(4) { animation-delay: 0.4s; }
.timeline-milestone:nth-child(5) { animation-delay: 0.5s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Alternating Layout */
.timeline-milestone:nth-child(odd) {
  padding-right: 50%;
}

.timeline-milestone:nth-child(even) {
  padding-left: 50%;
  text-align: right;
}

.timeline-milestone:nth-child(odd) .milestone-content {
  margin-right: 2rem;
}

.timeline-milestone:nth-child(even) .milestone-content {
  margin-left: 2rem;
}

/* Milestone Markers */
.milestone-marker {
  position: absolute;
  left: 50%;
  top: 2rem;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}

.marker-dot {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 4px solid var(--global-bg-color);
  box-shadow: 0 0 0 4px currentColor;
  transition: all 0.3s ease;
  margin-bottom: 0.5rem;
}

.marker-dot.education {
  background: #10b981;
  color: #10b981;
}

.marker-dot.career {
  background: #3b82f6;
  color: #3b82f6;
}

.marker-dot.growth {
  background: var(--journey-primary);
  color: var(--journey-primary);
}

.marker-dot.leadership {
  background: var(--journey-accent);
  color: var(--journey-accent);
}

.marker-dot.innovation {
  background: #8b5cf6;
  color: #8b5cf6;
}

.marker-label {
  background: var(--journey-surface);
  color: var(--global-text-color);
  padding: 0.25rem 0.75rem;
  border-radius: 15px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid var(--journey-border);
  white-space: nowrap;
}

.timeline-milestone:hover .marker-dot {
  transform: scale(1.2);
  box-shadow: 0 0 0 4px currentColor, 0 0 20px rgba(0,0,0,0.2);
}

/* Content Cards */
.content-card {
  background: var(--journey-surface);
  border: 1px solid var(--journey-border);
  border-radius: 16px;
  padding: 2rem;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

.content-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
  border-color: var(--journey-primary);
}

/* Content Card Arrows */
.timeline-milestone:nth-child(odd) .content-card::after {
  content: '';
  position: absolute;
  right: -15px;
  top: 2rem;
  width: 0;
  height: 0;
  border: 15px solid transparent;
  border-left-color: var(--journey-surface);
}

.timeline-milestone:nth-child(even) .content-card::after {
  content: '';
  position: absolute;
  left: -15px;
  top: 2rem;
  width: 0;
  height: 0;
  border: 15px solid transparent;
  border-right-color: var(--journey-surface);
}

.content-card h3 {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  color: var(--global-text-color);
}

.content-card h4 {
  font-size: 1.125rem;
  color: var(--journey-primary);
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.period {
  color: var(--global-text-color-light);
  font-size: 0.875rem;
  margin-bottom: 1rem;
  font-weight: 500;
}

.description {
  color: var(--global-text-color-light);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

/* Tags */
.achievements, .skills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.achievement-tag {
  background: linear-gradient(135deg, var(--journey-success), #34d399);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 15px;
  font-size: 0.75rem;
  font-weight: 500;
}

.skill-tag {
  background: var(--journey-primary);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 15px;
  font-size: 0.75rem;
  font-weight: 500;
}

/* Achievements Section */
.journey-achievements {
  padding: 5rem 0;
  background: var(--journey-surface);
}

.journey-achievements h2 {
  text-align: center;
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 3rem;
  color: var(--global-text-color);
}

.achievements-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
}

.achievement-card {
  background: var(--global-bg-color);
  border: 1px solid var(--journey-border);
  border-radius: 16px;
  padding: 2rem;
  text-align: center;
  transition: all 0.3s ease;
}

.achievement-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
}

.achievement-icon {
  font-size: 2.5rem;
  color: var(--journey-primary);
  margin-bottom: 1rem;
}

.achievement-card h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--global-text-color);
}

.achievement-card p {
  color: var(--global-text-color-light);
  line-height: 1.5;
}

/* Responsive Design */
@media (max-width: 768px) {
  .journey-timeline::before {
    left: 30px;
    transform: none;
  }
  
  .timeline-milestone {
    padding-left: 70px !important;
    padding-right: 0 !important;
    text-align: left !important;
  }
  
  .milestone-marker {
    left: 30px;
    transform: none;
  }
  
  .timeline-milestone .milestone-content {
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  
  .timeline-milestone:nth-child(odd) .content-card::after,
  .timeline-milestone:nth-child(even) .content-card::after {
    display: none;
  }
  
  .hero-title {
    font-size: 2.5rem;
  }
  
  .hero-actions {
    flex-direction: column;
  }
  
  .section-header h2 {
    font-size: 2rem;
  }
  
  .achievements-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .journey-timeline::before {
    left: 20px;
  }
  
  .milestone-marker {
    left: 20px;
  }
  
  .timeline-milestone {
    padding-left: 50px !important;
  }
  
  .container {
    padding: 0 1rem;
  }
}
</style>

<script>
(function() {
  // Smooth scrolling for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Intersection Observer for timeline animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  // Observe timeline milestones
  document.querySelectorAll('.timeline-milestone').forEach(milestone => {
    observer.observe(milestone);
  });
})();
</script>