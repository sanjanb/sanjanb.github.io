---
layout: default
---
{% assign year = page.started | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<!-- Mobile Desktop View Suggestion Popup -->
<div id="mobileViewPopup" class="mobile-popup-overlay" style="display: none;">
  <div class="mobile-popup-content">
    <div class="mobile-popup-header">
      <i class="fas fa-desktop"></i>
      <h3>Better Experience Available</h3>
    </div>
    <div class="mobile-popup-body">
      <p>This site looks amazing in desktop view! Would you like to switch to desktop view for the best experience?</p>
    </div>
    <div class="mobile-popup-actions">
      <button id="switchToDesktop" class="btn-popup-primary">
        <i class="fas fa-desktop"></i>
        Switch to Desktop View
      </button>
      <button id="stayMobile" class="btn-popup-secondary">
        <i class="fas fa-mobile-alt"></i>
        Continue Mobile View
      </button>
    </div>
  </div>
</div>

<!-- Hero Section -->
<div class="teaching-hero">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-eyebrow" style="color: rgba(255, 255, 255, 0.9) !important;">Knowledge sharing & education</div>
      <h1 class="hero-title" style="color: white !important;">{{ page.title }}</h1>
      {% if page.description %}
        <p class="hero-description" style="color: rgba(255, 255, 255, 0.95) !important;">{{ page.description }}</p>
      {% endif %}
      
      <div class="hero-stats">
        {% assign course_count = site.teaching | size %}
        {% assign total_students = 0 %}
        {% for course in site.teaching %}
          {% if course.students %}
            {% assign student_num = course.students | replace: '+', '' | replace: ' students', '' | replace: ' student', '' | plus: 0 %}
            {% assign total_students = total_students | plus: student_num %}
          {% endif %}
        {% endfor %}
        
        <div class="stat-item">
          <span class="stat-number" style="color: white !important;">{{ course_count }}</span>
          <span class="stat-label" style="color: rgba(255, 255, 255, 0.9) !important;">Courses</span>
        </div>
        <div class="stat-item">
          <span class="stat-number" style="color: white !important;">{{ total_students }}+</span>
          <span class="stat-label" style="color: rgba(255, 255, 255, 0.9) !important;">Students</span>
        </div>
        <div class="stat-item">
          <span class="stat-number" style="color: white !important;">4.8★</span>
          <span class="stat-label" style="color: rgba(255, 255, 255, 0.9) !important;">Rating</span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="post">
  <article>
    {{ content }}
    
    <!-- Enhanced Filter Section -->
    <div class="enhanced-filters">
      <div class="filter-header">
        <h3>Explore Courses</h3>
        <p>Filter by category to find the perfect learning path</p>
      </div>
      <div class="filter-buttons">
        <button class="filter-btn active" data-filter="all">
          <i class="fas fa-th-large"></i>
          <span>All Courses</span>
        </button>
        <button class="filter-btn" data-filter="programming">
          <i class="fas fa-code"></i>
          <span>Programming</span>
        </button>
        <button class="filter-btn" data-filter="data-science">
          <i class="fas fa-chart-bar"></i>
          <span>Data Science</span>
        </button>
        <button class="filter-btn" data-filter="ai-ml">
          <i class="fas fa-robot"></i>
          <span>AI & ML</span>
        </button>
        <button class="filter-btn" data-filter="web-dev">
          <i class="fas fa-globe"></i>
          <span>Web Dev</span>
        </button>
      </div>
    </div>

    <!-- Enhanced Course Grid -->
    <div class="enhanced-teaching-grid">
      {% assign sorted_teaching = site.teaching | sort: 'importance' %}
      {% for course in sorted_teaching %}
        <div class="enhanced-course-card" data-category="{{ course.category }}">
          <div class="course-card-header">
            <div class="course-icon">
              {% if course.icon %}
                <i class="{{ course.icon }}"></i>
              {% else %}
                {% case course.category %}
                  {% when 'programming' %}
                    <i class="fas fa-code"></i>
                  {% when 'data-science' %}
                    <i class="fas fa-chart-bar"></i>
                  {% when 'ai-ml' %}
                    <i class="fas fa-robot"></i>
                  {% when 'web-dev' %}
                    <i class="fas fa-globe"></i>
                  {% else %}
                    <i class="fas fa-book"></i>
                {% endcase %}
              {% endif %}
            </div>
            {% if course.level %}
              <span class="course-level level-{{ course.level }}">{{ course.level | capitalize }}</span>
            {% endif %}
          </div>
          
          <div class="course-content">
            <h3 class="course-title">
              <a href="{% if course.redirect %}{{ course.redirect }}{% else %}{{ course.url | relative_url }}{% endif %}">
                {{ course.title }}
              </a>
            </h3>
            <p class="course-description">{{ course.description }}</p>
            
            <div class="course-highlights">
              {% if course.duration %}
                <div class="highlight-item">
                  <i class="fas fa-clock"></i>
                  <span>{{ course.duration }}</span>
                </div>
              {% endif %}
              {% if course.students %}
                <div class="highlight-item">
                  <i class="fas fa-users"></i>
                  <span>{{ course.students }}</span>
                </div>
              {% endif %}
              {% if course.date %}
                <div class="highlight-item">
                  <i class="fas fa-calendar"></i>
                  <span>{{ course.date | date: "%Y" }}</span>
                </div>
              {% endif %}
            </div>

            {% if course.tags %}
              <div class="course-tags">
                {% for tag in course.tags limit: 4 %}
                  <span class="course-tag">{{ tag }}</span>
                {% endfor %}
                {% if course.tags.size > 4 %}
                  <span class="course-tag more">+{{ course.tags.size | minus: 4 }}</span>
                {% endif %}
              </div>
            {% endif %}

            <div class="course-actions">
              <a href="{% if course.redirect %}{{ course.redirect }}{% else %}{{ course.url | relative_url }}{% endif %}" class="btn-course-primary">
                <i class="fas fa-book-open"></i>
                <span>Explore Course</span>
              </a>
              {% if course.github %}
                <a href="{{ course.github }}" target="_blank" class="btn-course-secondary" rel="external nofollow noopener">
                  <i class="fab fa-github"></i>
                </a>
              {% endif %}
              {% if course.course_url %}
                <a href="{{ course.course_url }}" target="_blank" class="btn-course-secondary" rel="external nofollow noopener">
                  <i class="fas fa-external-link-alt"></i>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>

<style>
/* Mobile Desktop View Popup */
.mobile-popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(5px);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.3s ease-out;
}

.mobile-popup-content {
  background: var(--global-card-bg-color);
  border-radius: 20px;
  padding: 2rem;
  max-width: 400px;
  width: 100%;
  box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.25);
  border: 1px solid var(--global-divider-color);
  text-align: center;
  animation: slideUp 0.3s ease-out;
}

.mobile-popup-header {
  margin-bottom: 1.5rem;
}

.mobile-popup-header i {
  font-size: 3rem;
  color: var(--global-theme-color);
  margin-bottom: 1rem;
}

.mobile-popup-header h3 {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--global-text-color);
}

.mobile-popup-body {
  margin-bottom: 2rem;
}

.mobile-popup-body p {
  margin: 0;
  color: var(--global-text-color-light);
  line-height: 1.6;
  font-size: 1rem;
}

.mobile-popup-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.btn-popup-primary {
  background: var(--global-theme-color);
  color: var(--global-hover-text-color);
  border: none;
  padding: 1rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-popup-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(var(--global-theme-color-rgb), 0.3);
}

.btn-popup-secondary {
  background: var(--global-bg-color);
  color: var(--global-text-color-light);
  border: 1px solid var(--global-divider-color);
  padding: 0.75rem 1.5rem;
  border-radius: 12px;
  font-weight: 500;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-popup-secondary:hover {
  background: var(--global-text-color-light);
  color: var(--global-bg-color);
  transform: translateY(-1px);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Override global text color specifically for hero section */
.teaching-hero p,
.teaching-hero h1,
.teaching-hero h2,
.teaching-hero h3,
.teaching-hero h4,
.teaching-hero h5,
.teaching-hero h6,
.teaching-hero em,
.teaching-hero div,
.teaching-hero li,
.teaching-hero span,
.teaching-hero strong {
  color: white !important;
}

.teaching-hero .hero-eyebrow {
  color: rgba(255, 255, 255, 0.9) !important;
}

.teaching-hero .hero-description {
  color: rgba(255, 255, 255, 0.95) !important;
}

.teaching-hero .stat-label {
  color: rgba(255, 255, 255, 0.9) !important;
}

/* Hero Section */
.teaching-hero {
  background: var(--global-theme-color);
  border-radius: 20px;
  margin: 1rem 0 3rem;
  padding: 3rem 2rem;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20px 60px -12px rgba(181, 9, 172, 0.4);
}

.teaching-hero::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, .1), transparent);
  transform: translateX(-100%);
  transition: transform .6s ease;
}

.teaching-hero:hover::before {
  transform: translateX(100%);
}

.hero-container {
  position: relative;
  z-index: 1;
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.hero-content {
  position: relative;
  z-index: 2;
  color: white !important;
}

.hero-content * {
  color: white !important;
}

.hero-content .hero-eyebrow {
  font-size: 0.8rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.9) !important;
  font-weight: 500;
  margin-bottom: 0.75rem;
}

.hero-content .hero-title {
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  font-weight: 700;
  color: white !important;
  margin-bottom: 1rem;
  line-height: 1.1;
}

.hero-content .hero-description {
  font-size: 1.2rem;
  color: rgba(255, 255, 255, 0.95) !important;
  margin-bottom: 2rem;
  line-height: 1.6;
  max-width: 70ch;
  margin-left: auto;
  margin-right: auto;
}

.hero-stats {
  display: flex;
  justify-content: center;
  gap: 2rem;
  flex-wrap: wrap;
  margin-top: 2rem;
}

.hero-stats * {
  color: white !important;
}

.hero-stats .stat-item {
  text-align: center;
  color: white !important;
}

.hero-stats .stat-number {
  display: block;
  font-size: 2rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 0.25rem;
  color: white !important;
}

.hero-stats .stat-label {
  font-size: 0.9rem;
  opacity: 0.9;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: rgba(255, 255, 255, 0.9) !important;
}

/* Enhanced Filters */
.enhanced-filters {
  background: var(--global-card-bg-color);
  border: 1px solid var(--global-divider-color);
  border-radius: 16px;
  padding: 2rem;
  margin: 2rem 0 3rem;
  text-align: center;
}

.filter-header {
  margin-bottom: 1.5rem;
}

.filter-header h3 {
  margin: 0 0 0.5rem;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--global-text-color);
}

.filter-header p {
  margin: 0;
  color: var(--global-text-color-light);
  font-size: 1rem;
}

.filter-buttons {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--global-bg-color);
  border: 1px solid var(--global-divider-color);
  color: var(--global-text-color);
  padding: 0.75rem 1.25rem;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 500;
  font-size: 0.9rem;
  position: relative;
  overflow: hidden;
}

.filter-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--global-theme-color);
  transform: scaleX(0);
  transition: transform 0.3s ease;
  z-index: -1;
}

.filter-btn:hover::before,
.filter-btn.active::before {
  transform: scaleX(1);
}

.filter-btn:hover,
.filter-btn.active {
  color: var(--global-hover-text-color);
  border-color: var(--global-theme-color);
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(var(--global-theme-color-rgb), 0.3);
}

.filter-btn i {
  font-size: 1rem;
}

/* Enhanced Course Grid */
.enhanced-teaching-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.enhanced-course-card {
  background: var(--global-card-bg-color);
  border: 1px solid var(--global-divider-color);
  border-radius: 20px;
  padding: 1.75rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  opacity: 1;
  transform: scale(1);
}

.enhanced-course-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--global-theme-color), transparent);
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.enhanced-course-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.15);
  border-color: rgba(var(--global-theme-color-rgb), 0.3);
}

.enhanced-course-card:hover::before {
  transform: scaleX(1);
}

.enhanced-course-card.hidden {
  opacity: 0;
  transform: scale(0.9);
  pointer-events: none;
}

.course-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1.25rem;
}

.course-icon {
  width: 50px;
  height: 50px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(var(--global-theme-color-rgb), 0.1), rgba(var(--global-theme-color-rgb), 0.05));
  border: 1px solid rgba(var(--global-theme-color-rgb), 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  color: var(--global-theme-color);
}

.course-level {
  padding: 0.3rem 0.7rem;
  border-radius: 20px;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.05em;
}

.level-beginner {
  background: rgba(34, 197, 94, 0.1);
  color: rgb(34, 197, 94);
}

.level-intermediate {
  background: rgba(251, 191, 36, 0.1);
  color: rgb(251, 191, 36);
}

.level-advanced {
  background: rgba(239, 68, 68, 0.1);
  color: rgb(239, 68, 68);
}

.course-content {
  flex: 1;
}

.course-title {
  font-size: 1.3rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
  line-height: 1.3;
}

.course-title a {
  color: var(--global-text-color);
  text-decoration: none;
  transition: color 0.3s ease;
}

.course-title a:hover {
  color: var(--global-theme-color);
}

.course-description {
  color: var(--global-text-color-light);
  line-height: 1.6;
  margin-bottom: 1.25rem;
  font-size: 0.95rem;
}

.course-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.highlight-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  color: var(--global-text-color-light);
}

.highlight-item i {
  color: var(--global-theme-color);
  font-size: 0.9rem;
}

.course-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.course-tag {
  background: rgba(var(--global-theme-color-rgb), 0.08);
  color: var(--global-theme-color);
  padding: 0.3rem 0.7rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 500;
  border: 1px solid rgba(var(--global-theme-color-rgb), 0.15);
}

.course-tag.more {
  background: var(--global-bg-color);
  color: var(--global-text-color-light);
  border-color: var(--global-divider-color);
}

.course-actions {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.btn-course-primary {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--global-theme-color);
  color: var(--global-hover-text-color);
  padding: 0.75rem 1.25rem;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex: 1;
  justify-content: center;
  border: none;
}

.btn-course-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(var(--global-theme-color-rgb), 0.3);
  color: var(--global-hover-text-color);
}

.btn-course-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: var(--global-bg-color);
  color: var(--global-text-color-light);
  border: 1px solid var(--global-divider-color);
  border-radius: 12px;
  text-decoration: none;
  transition: all 0.3s ease;
  font-size: 1rem;
}

.btn-course-secondary:hover {
  background: var(--global-text-color-light);
  color: var(--global-bg-color);
  transform: translateY(-2px);
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .teaching-hero {
    padding: 2rem 1.5rem;
    margin: 0.5rem 0 2rem;
  }
  
  .hero-title {
    font-size: 2rem;
  }
  
  .hero-description {
    font-size: 1rem;
  }
  
  .hero-stats {
    gap: 1.5rem;
  }
  
  .stat-number {
    font-size: 1.5rem;
  }
  
  .enhanced-filters {
    padding: 1.5rem;
  }
  
  .filter-buttons {
    gap: 0.5rem;
  }
  
  .filter-btn {
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
  }
  
  .enhanced-teaching-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .enhanced-course-card {
    padding: 1.5rem;
  }
  
  .course-highlights {
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .course-actions {
    flex-direction: column;
  }
  
  .btn-course-secondary {
    width: 100%;
    height: 44px;
  }
}

@media (max-width: 480px) {
  .teaching-hero {
    padding: 1.5rem 1rem;
  }
  
  .hero-title {
    font-size: 1.75rem;
  }
  
  .filter-btn span {
    display: none;
  }
  
  .filter-btn {
    padding: 0.6rem;
    width: 44px;
    height: 44px;
    justify-content: center;
  }
  
  .enhanced-course-card {
    padding: 1.25rem;
  }
  
  .course-icon {
    width: 44px;
    height: 44px;
    font-size: 1.2rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterBtns = document.querySelectorAll('.filter-btn');
  const teachingCards = document.querySelectorAll('.teaching-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      // Remove active class from all buttons
      filterBtns.forEach(b => b.classList.remove('active'));
      // Add active class to clicked button
      this.classList.add('active');

      const filter = this.getAttribute('data-filter');

      teachingCards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Mobile Desktop View Suggestion
  function isMobileDevice() {
    return window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  }

  function showMobilePopup() {
    // Check if user has already seen this popup (using localStorage)
    const hasSeenPopup = localStorage.getItem('mobileViewPopupSeen');
    
    if (!hasSeenPopup && isMobileDevice()) {
      document.getElementById('mobileViewPopup').style.display = 'flex';
    }
  }

  function switchToDesktopView() {
    // Force desktop viewport
    let viewport = document.querySelector('meta[name=viewport]');
    if (viewport) {
      viewport.setAttribute('content', 'width=1024');
    } else {
      viewport = document.createElement('meta');
      viewport.name = 'viewport';
      viewport.content = 'width=1024';
      document.getElementsByTagName('head')[0].appendChild(viewport);
    }
    
    // Hide popup and mark as seen
    document.getElementById('mobileViewPopup').style.display = 'none';
    localStorage.setItem('mobileViewPopupSeen', 'true');
    
    // Add a class to body for any additional desktop-specific styling
    document.body.classList.add('force-desktop-view');
  }

  function stayMobileView() {
    // Hide popup and mark as seen
    document.getElementById('mobileViewPopup').style.display = 'none';
    localStorage.setItem('mobileViewPopupSeen', 'true');
  }

  // Event listeners for popup buttons
  document.getElementById('switchToDesktop').addEventListener('click', switchToDesktopView);
  document.getElementById('stayMobile').addEventListener('click', stayMobileView);

  // Show popup if on mobile device
  showMobilePopup();
});
</script>