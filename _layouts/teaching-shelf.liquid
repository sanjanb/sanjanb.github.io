---
layout: default
---
{% assign year = page.started | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header teaching-header">
    <div class="header-content">
      <h1 class="post-title">
        <i class="fas fa-chalkboard-teacher header-icon"></i>
        {{ page.title | capitalize }}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </div>
  </header>

  <article>
    {{ content }}
    
    <div class="teaching-filters">
      <button class="filter-btn active" data-filter="all">All Courses</button>
      <button class="filter-btn" data-filter="programming">Programming</button>
      <button class="filter-btn" data-filter="data-science">Data Science</button>
      <button class="filter-btn" data-filter="ai-ml">AI & ML</button>
      <button class="filter-btn" data-filter="web-dev">Web Development</button>
    </div>

    <div class="teaching-grid" id="teaching-grid">
      {% assign sorted_teaching = site.teaching | sort: 'importance' | sort: 'date' | reverse %}
      {% if sorted_teaching == empty %}
        <div class="empty-state">
          <div class="icon"><i class="fas fa-hourglass-half"></i></div>
          <h3>Content in Progress</h3>
          <p>Courses will appear here soon. Stay tuned!</p>
        </div>
      {% endif %}
      {% for course in sorted_teaching %}
        <div class="teaching-card" data-category="{{ course.category }}">
          <div class="teaching-icon">
            {% if course.icon %}
              <i class="{{ course.icon }}"></i>
            {% else %}
              {% case course.category %}
                {% when 'programming' %}
                  <i class="fas fa-code"></i>
                {% when 'data-science' %}
                  <i class="fas fa-chart-bar"></i>
                {% when 'ai-ml' %}
                  <i class="fas fa-robot"></i>
                {% when 'web-dev' %}
                  <i class="fas fa-globe"></i>
                {% else %}
                  <i class="fas fa-book"></i>
              {% endcase %}
            {% endif %}
          </div>
          
          <h3 class="teaching-title">
            <a href="{% if course.redirect %}{{ course.redirect }}{% else %}{{ course.url | relative_url }}{% endif %}">
              {{ course.title }}
            </a>
          </h3>
          
          <p class="teaching-description">{{ course.description }}</p>
          
          <div class="teaching-meta">
            {% if course.duration %}
              <span><i class="fas fa-clock"></i> {{ course.duration }}</span>
            {% endif %}
            {% if course.students %}
              <span><i class="fas fa-users"></i> {{ course.students }}</span>
            {% endif %}
            {% if course.level %}
              <span class="level">{{ course.level | capitalize }}</span>
            {% endif %}
          </div>

          {% if course.live_url %}
            <a href="{{ course.live_url }}" target="_blank" class="course-link">
              View Course <i class="fas fa-external-link-alt"></i>
            </a>
          {% endif %}
                </a>
              {% endif %}
              {% if course.github %}
                <a href="{{ course.github }}" target="_blank" class="btn btn-outline">
                  <i class="fab fa-github"></i>
                  <span>Code</span>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
                  <i class="fab fa-github"></i> Code
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>

<style>
/* Teaching Header */
.teaching-header {
  margin-bottom: 2rem;
}

.teaching-header .post-title {
  font-size: 2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--global-text-color);
}

.header-icon {
  color: var(--global-theme-color);
  margin-right: 0.5rem;
}

.teaching-header .post-description {
  color: var(--global-text-color-light);
  margin: 0;
}

/* Filters */
.teaching-filters {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin: 1.5rem 0;
  flex-wrap: wrap;
}

.filter-btn {
  background: transparent;
  border: 1px solid var(--global-divider-color);
  color: var(--global-text-color-light);
  padding: 0.5rem 1rem;
  border-radius: 2rem;
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 0.875rem;
  font-weight: 500;
}

.filter-btn:hover,
.filter-btn.active {
  background: var(--global-theme-color);
  border-color: var(--global-theme-color);
  color: white;
}

/* Grid */
.teaching-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
  margin-top: 1.5rem;
}

/* Teaching Cards */
.teaching-card {
  background: var(--global-card-bg-color);
  border: 1px solid var(--global-divider-color);
  border-radius: 0.75rem;
  padding: 1.25rem;
  transition: border-color 0.2s ease;
}

.teaching-card:hover {
  border-color: var(--global-theme-color);
}

.teaching-card.hidden {
  display: none;
}

.teaching-icon {
  font-size: 1.75rem;
  color: var(--global-theme-color);
  margin-bottom: 1rem;
}

.teaching-title {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  line-height: 1.3;
}

.teaching-title a {
  color: var(--global-text-color);
  text-decoration: none;
}

.teaching-title a:hover {
  color: var(--global-theme-color);
}

.teaching-description {
  color: var(--global-text-color-light);
  margin-bottom: 1rem;
  line-height: 1.5;
  font-size: 0.9rem;
}

.teaching-meta {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
  font-size: 0.8rem;
  color: var(--global-text-color-light);
  flex-wrap: wrap;
}

.teaching-meta i {
  margin-right: 0.25rem;
  color: var(--global-theme-color);
}

.level {
  background: var(--global-code-bg-color);
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
  font-weight: 500;
  text-transform: uppercase;
  font-size: 0.7rem;
}

.course-link {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  color: var(--global-theme-color);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.875rem;
  transition: color 0.2s ease;
}

.course-link:hover {
  color: var(--global-hover-color);
}

.course-link i {
  font-size: 0.75rem;
}

/* Empty State */
.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 2rem;
  border: 1px dashed var(--global-divider-color);
  border-radius: 0.75rem;
  color: var(--global-text-color-light);
}

.empty-state .icon {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  color: var(--global-text-color-light);
}

/* Responsive */
@media (max-width: 768px) {
  .teaching-header .post-title {
    font-size: 1.75rem;
  }

  .teaching-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .teaching-card {
    padding: 1rem;
  }

  .filter-btn {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }

  .teaching-meta {
    flex-direction: column;
    gap: 0.5rem;
  }
}
</style>
</style>

.level-advanced {
  background: rgba(239, 68, 68, 0.1);
  color: rgb(239, 68, 68);
}

.teaching-tags {
  margin-bottom: 1rem;
}

.tag {
  display: inline-block;
  background: var(--global-bg-color);
  color: var(--global-text-color-light);
  padding: 0.25rem 0.5rem;
  margin: 0.125rem;
  border-radius: 0.25rem;
  font-size: 0.75rem;
  border: 1px solid var(--global-divider-color);
}

/* quick outcomes removed */

.teaching-links {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.btn {
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.btn-primary {
  background: var(--global-theme-color);
  color: white;
  border: 1px solid var(--global-theme-color);
}

.btn-primary:hover {
  background: var(--global-theme-color);
  opacity: 0.9;
  color: white;
}

.btn-outline-secondary {
  background: transparent;
  color: var(--global-text-color-light);
  border: 1px solid var(--global-divider-color);
}

.btn-outline-secondary:hover {
  background: var(--global-text-color-light);
  color: var(--global-bg-color);
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .teaching-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  /* stats removed */
  
  .teaching-card {
    padding: 1rem;
  }
  
  .filter-btn {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }
  
  .teaching-meta {
    flex-direction: column;
    gap: 0.5rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterBtns = document.querySelectorAll('.filter-btn');
  const teachingCards = document.querySelectorAll('.teaching-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      // Remove active class from all buttons
      filterBtns.forEach(b => b.classList.remove('active'));
      // Add active class to clicked button
      this.classList.add('active');

      const filter = this.getAttribute('data-filter');

      teachingCards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
});
</script>