---
layout: default
---
{% assign year = page.started | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header teaching-header">
    <div class="header-content">
      <h1 class="post-title">
        <i class="fas fa-chalkboard-teacher header-icon"></i>
        {{ page.title | capitalize }}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </div>
  </header>

  <article>
    {{ content }}
    
    <div class="teaching-filters">
      <button class="filter-btn active" data-filter="all">All Courses</button>
      <button class="filter-btn" data-filter="programming">Programming</button>
      <button class="filter-btn" data-filter="data-science">Data Science</button>
      <button class="filter-btn" data-filter="ai-ml">AI & ML</button>
      <button class="filter-btn" data-filter="web-dev">Web Development</button>
    </div>

    <div class="teaching-grid" id="teaching-grid">
      {% assign sorted_teaching = site.teaching | sort: 'importance' | sort: 'date' | reverse %}
      {% if sorted_teaching == empty %}
        <div class="empty-state">
          <div class="icon"><i class="fas fa-hourglass-half"></i></div>
          <h3>Content in Progress</h3>
          <p>Courses will appear here soon. Stay tuned!</p>
        </div>
      {% endif %}
      {% for course in sorted_teaching %}
        <div class="teaching-card" data-category="{{ course.category }}">
          <div class="card-top">
            <div class="teaching-icon">
              {% if course.icon %}
                <i class="{{ course.icon }}"></i>
              {% else %}
                {% case course.category %}
                  {% when 'programming' %}
                    <i class="fas fa-code"></i>
                  {% when 'data-science' %}
                    <i class="fas fa-chart-bar"></i>
                  {% when 'ai-ml' %}
                    <i class="fas fa-robot"></i>
                  {% when 'web-dev' %}
                    <i class="fas fa-globe"></i>
                  {% else %}
                    <i class="fas fa-book"></i>
                {% endcase %}
              {% endif %}
            </div>
            {% if course.level %}
              <span class="level-chip">{{ course.level | slice: 0, 3 | capitalize }}</span>
            {% endif %}
          </div>
          
          <h4 class="course-title">
            <a href="{% if course.redirect %}{{ course.redirect }}{% else %}{{ course.url | relative_url }}{% endif %}">
              {{ course.title }}
            </a>
          </h4>
          
          <p class="course-desc">{{ course.description | truncate: 80 }}</p>
          
          <div class="course-info">
            {% if course.duration %}
              <span class="info-item"><i class="fas fa-clock"></i>{{ course.duration }}</span>
            {% endif %}
            {% if course.students %}
              <span class="info-item"><i class="fas fa-users"></i>{{ course.students }}</span>
            {% endif %}
          </div>
                </a>
              {% endif %}
              {% if course.github %}
                <a href="{{ course.github }}" target="_blank" class="btn btn-outline">
                  <i class="fab fa-github"></i>
                  <span>Code</span>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
                  <i class="fab fa-github"></i> Code
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>

<style>
/* Header */
.teaching-header {
  margin-bottom: 1.5rem;
}

.teaching-header .post-title {
  font-size: 1.75rem;
  font-weight: 600;
  margin-bottom: 0.375rem;
  color: var(--global-text-color);
}

.header-icon {
  color: var(--global-theme-color);
  margin-right: 0.5rem;
  font-size: 1.5rem;
}

.teaching-header .post-description {
  color: var(--global-text-color-light);
  font-size: 0.875rem;
  margin: 0;
}

/* Filters */
.teaching-filters {
  display: flex;
  justify-content: center;
  gap: 0.375rem;
  margin: 1.25rem 0;
  flex-wrap: wrap;
}

.filter-btn {
  background: transparent;
  border: 1px solid var(--global-divider-color);
  color: var(--global-text-color-light);
  padding: 0.375rem 0.75rem;
  border-radius: 1rem;
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 0.75rem;
  font-weight: 500;
}

.filter-btn:hover,
.filter-btn.active {
  background: var(--global-theme-color);
  border-color: var(--global-theme-color);
  color: white;
}

/* Grid */
.teaching-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}

/* Compact Teaching Cards */
.teaching-card {
  background: var(--global-card-bg-color);
  border: 1px solid var(--global-divider-color);
  border-radius: 0.625rem;
  padding: 1rem;
  transition: all 0.2s ease;
  cursor: pointer;
  position: relative;
}

.teaching-card:hover {
  border-color: var(--global-theme-color);
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.teaching-card.hidden {
  display: none;
}

/* Card Top Row */
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.teaching-icon {
  font-size: 1.25rem;
  color: var(--global-theme-color);
  width: 2rem;
  height: 2rem;
  background: rgba(181, 9, 172, 0.08);
  border-radius: 0.375rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-chip {
  background: var(--global-code-bg-color);
  color: var(--global-text-color);
  padding: 0.125rem 0.375rem;
  border-radius: 0.25rem;
  font-size: 0.625rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Course Title */
.course-title {
  font-size: 1rem;
  font-weight: 600;
  margin: 0 0 0.5rem 0;
  line-height: 1.3;
}

.course-title a {
  color: var(--global-text-color);
  text-decoration: none;
  transition: color 0.2s ease;
}

.course-title a:hover {
  color: var(--global-theme-color);
}

/* Description */
.course-desc {
  color: var(--global-text-color-light);
  font-size: 0.8rem;
  line-height: 1.4;
  margin: 0 0 0.75rem 0;
}

/* Course Info */
.course-info {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.7rem;
  color: var(--global-text-color-light);
  font-weight: 500;
}

.info-item i {
  font-size: 0.65rem;
  color: var(--global-theme-color);
}

/* Empty State */
.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 1.5rem;
  border: 1px dashed var(--global-divider-color);
  border-radius: 0.625rem;
  color: var(--global-text-color-light);
  font-size: 0.85rem;
}

.empty-state .icon {
  font-size: 1.5rem;
  margin-bottom: 0.375rem;
  color: var(--global-text-color-light);
}

.empty-state h3 {
  font-size: 0.9rem;
  margin: 0 0 0.25rem 0;
}

.empty-state p {
  margin: 0;
  font-size: 0.75rem;
}

/* Responsive */
@media (max-width: 768px) {
  .teaching-header .post-title {
    font-size: 1.5rem;
  }

  .teaching-grid {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .teaching-card {
    padding: 0.875rem;
  }

  .filter-btn {
    padding: 0.3rem 0.6rem;
    font-size: 0.7rem;
  }

  .course-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
  }
}

@media (max-width: 480px) {
  .teaching-header {
    margin-bottom: 1rem;
  }

  .teaching-header .post-title {
    font-size: 1.375rem;
  }

  .teaching-card {
    padding: 0.75rem;
  }

  .course-title {
    font-size: 0.925rem;
  }

  .course-desc {
    font-size: 0.75rem;
  }
}
</style>
</style>

.level-advanced {
  background: rgba(239, 68, 68, 0.1);
  color: rgb(239, 68, 68);
}

.teaching-tags {
  margin-bottom: 1rem;
}

.tag {
  display: inline-block;
  background: var(--global-bg-color);
  color: var(--global-text-color-light);
  padding: 0.25rem 0.5rem;
  margin: 0.125rem;
  border-radius: 0.25rem;
  font-size: 0.75rem;
  border: 1px solid var(--global-divider-color);
}

/* quick outcomes removed */

.teaching-links {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.btn {
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.btn-primary {
  background: var(--global-theme-color);
  color: white;
  border: 1px solid var(--global-theme-color);
}

.btn-primary:hover {
  background: var(--global-theme-color);
  opacity: 0.9;
  color: white;
}

.btn-outline-secondary {
  background: transparent;
  color: var(--global-text-color-light);
  border: 1px solid var(--global-divider-color);
}

.btn-outline-secondary:hover {
  background: var(--global-text-color-light);
  color: var(--global-bg-color);
}

/* Mobile responsiveness */
@media (max-width: 768px) {
  .teaching-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  /* stats removed */
  
  .teaching-card {
    padding: 1rem;
  }
  
  .filter-btn {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }
  
  .teaching-meta {
    flex-direction: column;
    gap: 0.5rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const filterBtns = document.querySelectorAll('.filter-btn');
  const teachingCards = document.querySelectorAll('.teaching-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      // Remove active class from all buttons
      filterBtns.forEach(b => b.classList.remove('active'));
      // Add active class to clicked button
      this.classList.add('active');

      const filter = this.getAttribute('data-filter');

      teachingCards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
});
</script>