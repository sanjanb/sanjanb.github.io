---
layout: default
---
{% assign year = page.started | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
    
    <div class="achievements-list">
      {% assign sorted_achievements = site.achievements | sort: 'date' | reverse %}
      {% for achievement in sorted_achievements %}
        <div class="achievement-item">
          <div class="achievement-header">
            <h3><a href="{{ achievement.url | relative_url }}">{{ achievement.title }}</a></h3>
            {% if achievement.organization %}
              <p><em>{{ achievement.organization }}</em></p>
            {% endif %}
          </div>
          
          <div class="achievement-meta">
            {% if achievement.date %}
              <div class="meta-item">
                <i class="fa-solid fa-calendar fa-sm"></i>
                <span>{{ achievement.date | date: '%B %Y' }}</span>
              </div>
            {% endif %}
            {% if achievement.category %}
              <div class="meta-item">
                <i class="fa-solid fa-tag fa-sm"></i>
                <span>{{ achievement.category | capitalize }}</span>
              </div>
            {% endif %}
            {% if achievement.status == 'ongoing' %}
              <div class="meta-item">
                <i class="fa-solid fa-clock fa-sm"></i>
                <span>Ongoing</span>
              </div>
            {% endif %}
          </div>
          
          {% if achievement.summary %}
            <p class="achievement-summary">{{ achievement.summary }}</p>
          {% endif %}
          
          {% if achievement.tags %}
            <div class="achievement-tags">
              {% for tag in achievement.tags limit:4 %}
                <span class="tag">{{ tag }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </article>
</div>


