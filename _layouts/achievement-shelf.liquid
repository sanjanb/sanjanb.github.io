---
layout: default
---
{% assign year = page.started | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
    
    <div class="achievements-list">
      {% assign sorted_achievements = site.achievements | sort: 'date' | reverse %}
      {% for achievement in sorted_achievements %}
        <div class="achievement-item">
          <div class="achievement-header">
            <h3><a href="{{ achievement.url | relative_url }}">{{ achievement.title }}</a></h3>
            {% if achievement.organization %}
              <p><em>{{ achievement.organization }}</em></p>
            {% endif %}
          </div>
          
          <div class="achievement-meta">
            {% if achievement.date %}
              <div class="meta-item">
                <i class="fa-solid fa-calendar fa-sm"></i>
                <span>{{ achievement.date | date: '%B %Y' }}</span>
              </div>
            {% endif %}
            {% if achievement.category %}
              <div class="meta-item">
                <i class="fa-solid fa-tag fa-sm"></i>
                <span>{{ achievement.category | capitalize }}</span>
              </div>
            {% endif %}
            {% if achievement.status == 'ongoing' %}
              <div class="meta-item">
                <i class="fa-solid fa-clock fa-sm"></i>
                <span>Ongoing</span>
              </div>
            {% endif %}
          </div>
          
          {% if achievement.summary %}
            <p class="achievement-summary">{{ achievement.summary }}</p>
          {% endif %}
          
          {% if achievement.tags %}
            <div class="achievement-tags">
              {% for tag in achievement.tags limit:4 %}
                <span class="tag">{{ tag }}</span>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </article>
</div>

<style>
.achievements-list {
  margin-top: 2rem;
}

.achievement-item {
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--global-divider-color);
  
  &:last-child {
    border-bottom: none;
  }
}

.achievement-header {
  margin-bottom: 1rem;
  
  h3 {
    margin: 0 0 0.5rem 0;
    
    a {
      color: var(--global-text-color);
      text-decoration: none;
      
      &:hover {
        color: var(--global-theme-color);
      }
    }
  }
}

.achievement-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 0.8rem;
  font-size: 0.9rem;
  color: var(--global-text-color-light);
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
}

.achievement-summary {
  color: var(--global-text-color-light);
  line-height: 1.6;
  margin-bottom: 0.8rem;
}

.achievement-tags {
  .tag {
    display: inline-block;
    background: var(--global-bg-color);
    color: var(--global-text-color-light);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    font-size: 0.8rem;
    margin: 0.1rem;
    border: 1px solid var(--global-divider-color);
  }
}

// Mobile responsiveness
@media (max-width: 768px) {
  .achievement-meta {
    flex-direction: column;
    gap: 0.5rem;
  }
}
</style>
