<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}

        {% comment %} Global hero styles (lightweight) {% endcomment %}
        <style>
          /* Mobile Desktop View Popup */
          .mobile-popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            animation: fadeIn 0.3s ease-out;
          }

          .mobile-popup-content {
            background: var(--global-card-bg-color);
            border-radius: 20px;
            padding: 2rem;
            max-width: 400px;
            width: 100%;
            box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.25);
            border: 1px solid var(--global-divider-color);
            text-align: center;
            animation: slideUp 0.3s ease-out;
          }

          .mobile-popup-header {
            margin-bottom: 1.5rem;
          }

          .mobile-popup-header i {
            font-size: 3rem;
            color: var(--global-theme-color);
            margin-bottom: 1rem;
          }

          .mobile-popup-header h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--global-text-color);
          }

          .mobile-popup-body {
            margin-bottom: 2rem;
          }

          .mobile-popup-body p {
            margin: 0;
            color: var(--global-text-color-light);
            line-height: 1.6;
            font-size: 1rem;
          }

          .mobile-popup-actions {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
          }

          .btn-popup-primary {
            background: var(--global-theme-color);
            color: var(--global-hover-text-color);
            border: none;
            padding: 1rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
          }

          .btn-popup-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(181, 9, 172, 0.3);
          }

          .btn-popup-secondary {
            background: var(--global-bg-color);
            color: var(--global-text-color-light);
            border: 1px solid var(--global-divider-color);
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            font-weight: 500;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
          }

          .btn-popup-secondary:hover {
            background: var(--global-text-color-light);
            color: var(--global-bg-color);
            transform: translateY(-1px);
          }

          @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
          }

          @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
          }

          /* Global hero styles */
          .hero-block{padding:2.5rem 0 1.5rem;border-bottom:1px solid var(--global-border-color);} 
          .hero-title{margin:0 0 .75rem;font-size:clamp(2rem,4vw,2.75rem);line-height:1.15;font-weight:600;}
          .hero-meta{color:var(--global-text-color-light);font-size:.85rem;margin-bottom:1.1rem;}
          .hero-lead{max-width:880px;font-size:1.02rem;line-height:1.55rem;margin:0;}
          .hero-metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.75rem;margin:1.35rem 0 0;}
          .hero-metric{background:var(--global-card-bg-color);border:1px solid var(--global-divider-color);padding:.85rem .9rem;border-radius:12px;}
          .hero-metric h3{margin:0;font-size:1.1rem;font-weight:600;}
          .hero-metric p{margin:.2rem 0 0;font-size:.6rem;letter-spacing:.05em;text-transform:uppercase;color:var(--global-text-color-light);}
          @media (max-width:600px){.hero-block{padding:2rem 0 1rem;}.hero-title{font-size:1.9rem;}}
        </style>
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- Mobile Desktop View Suggestion Popup -->
    <div id="mobileViewPopup" class="mobile-popup-overlay" style="display: none;">
      <div class="mobile-popup-content">
        <div class="mobile-popup-header">
          <i class="fas fa-desktop"></i>
          <h3>Better Experience Available</h3>
        </div>
        <div class="mobile-popup-body">
          <p>This site looks amazing in desktop view! Would you like to switch to desktop view for the best experience?</p>
        </div>
        <div class="mobile-popup-actions">
          <button id="switchToDesktop" class="btn-popup-primary">
            <i class="fas fa-desktop"></i>
            Switch to Desktop View
          </button>
          <button id="stayMobile" class="btn-popup-secondary">
            <i class="fas fa-mobile-alt"></i>
            Continue Mobile View
          </button>
        </div>
      </div>
    </div>

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
