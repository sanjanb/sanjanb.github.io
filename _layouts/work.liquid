---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.hero %}
    {% include hero_heading.liquid %}
  {% else %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.company or page.date %}
        <p class="post-meta">
          {% if page.company %}
            {{ page.company }}
          {% endif %}
          {% if page.company and page.date %} &nbsp;&middot;&nbsp; {% endif %}
          {% if page.date %}
            {{ page.date | date: '%B %Y' }}
          {% endif %}
        </p>
      {% endif %}

      {% if page.start_date or page.end_date or page.duration %}
        <p class="post-meta">
          {% if page.start_date %}
            <i class="fa-solid fa-play fa-sm" style="color: var(--global-tip-block) !important"></i> <em>{{ page.start_date | date: '%B %Y' }}</em>
          {% endif %}
          {% if page.end_date %}
            {% if page.start_date %}
              &nbsp;&middot;&nbsp;
            {% endif %}
            {% if page.status == 'ongoing' %}
              <i class="fa-solid fa-clock fa-sm" style="color: #f39c12 !important"></i> <em>Present</em>
            {% else %}
              <i class="fa-solid fa-stop fa-sm" style="color: #e56565 !important"></i> <em>{{ page.end_date | date: '%B %Y' }}</em>
            {% endif %}
          {% endif %}
          {% if page.duration %}
            {% if page.start_date or page.end_date %}
              &nbsp;&middot;&nbsp;
            {% endif %}
            <i class="fa-solid fa-clock fa-sm"></i> <em>{{ page.duration }}</em>
          {% endif %}
          {% if page.website %}
            {% if page.start_date or page.end_date or page.duration %}
              &nbsp;&middot;&nbsp;
            {% endif %}
            <a target="_blank" href="{{ page.website }}"><i class="fa-solid fa-external-link-alt fa-sm"></i> View Project</a>
          {% endif %}
          {% if page.github %}
            {% if page.start_date or page.end_date or page.duration or page.website %}
              &nbsp;&middot;&nbsp;
            {% endif %}
            <a target="_blank" href="{{ page.github }}"><i class="fa-brands fa-github fa-sm"></i> GitHub</a>
          {% endif %}
        </p>
      {% endif %}
      
      <p class="post-tags">
        <a href="{{ year | prepend: '/work/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}</a>
        {% if tags != '' %}
          &nbsp;&middot;&nbsp;
          {% for tag in page.tags %}
            <a href="{{ tag | slugify | prepend: '/work/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% endif %}

        {% if categories != '' %}
          &nbsp;&middot;&nbsp;
          {% for category in page.categories %}
            <a href="{{ category | slugify | prepend: '/work/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category }}</a>
            {% unless forloop.last %}
              &nbsp;
            {% endunless %}
          {% endfor %}
        {% endif %}
      </p>
      <hr>
    </header>
  {% endif %}

  <article class="work-content">
    {% if page.summary %}
      <div class="work-summary">
        <p><strong>{{ page.summary }}</strong></p>
      </div>
    {% endif %}

    {{ content }}
    
    {% if page.impact %}
      <div class="work-impact">
        <h4>Impact & Results</h4>
        <ul>
          {% for impact in page.impact %}
            <li><strong>{{ impact.value }}</strong> - {{ impact.description }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
    
    {% if page.technologies %}
      <div class="work-technologies">
        <h4>Technologies Used</h4>
        <p>
          {% for tech in page.technologies %}
            <code>{{ tech }}</code>{% unless forloop.last %}, {% endunless %}
          {% endfor %}
        </p>
      </div>
    {% endif %}

    {% if page.responsibilities %}
      <div class="work-responsibilities">
        <h4>Key Responsibilities</h4>
        <ul>
          {% for responsibility in page.responsibilities %}
            <li>{{ responsibility }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </article>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>